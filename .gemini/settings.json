{
  // "model": "gemini-2.5-pro",
  // "temperature": 0.0,
  // "maxTokens": 8192,
  "allowedTools": [
    "read-file",
    "write-file",
    "search-text"
  ],
  "restrictedPaths": [
    "**/node_modules/**",
    "**/dist/**",
    "**/.git/**"
  ],
  "toolTimeouts": {
    "read-file": 5,
    "search-text": 10,
    "write-file": 10
  },
  "logging": {
    "level": "info",
    "destination": "console"
  }
}
