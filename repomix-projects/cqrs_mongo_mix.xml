<file path="src/application/commands/account/create-user-stream-key.command.ts">
import { CommandHandler, ICommand, ICommandHandler } from '@nestjs/cqrs';
import { randomBytes } from 'crypto';
import { IListenKey } from 'src/common/interface/listen-key-cache';
import { IUseCaseResponse } from 'src/common/interface/response/interface/response.result.interface';
import { ICacheManager } from 'src/core/interfaces/cache-manager.interface';
import { LoggerService } from 'src/infrastructure/logger/logger.service';
import { IApiRequestPayload } from 'src/presentation/dtos/api-key/api-key.response';

export class CreateUserStreamCommand implements ICommand {
  constructor(public readonly apiReqPayload: IApiRequestPayload) {}
}

@CommandHandler(CreateUserStreamCommand)
export class CreateUserStreamCommandHandler
  implements ICommandHandler<CreateUserStreamCommand, IUseCaseResponse<{ listenKey: string }>>
{
  constructor(
    private readonly cacheManager: ICacheManager,
    private readonly logger: LoggerService,
  ) {
    this.logger.setContext(CreateUserStreamCommandHandler.name);
  }

  async execute(command: CreateUserStreamCommand): Promise<IUseCaseResponse<{ listenKey: string }>> {
    try {
      const listenKey = randomBytes(16).toString('hex');

      await this.cacheManager.set<IListenKey>(
        `listen:${command.apiReqPayload.apiKey}`,
        {
          userId: command.apiReqPayload.userId,
          apiKey: command.apiReqPayload.apiKey,
          listenKey,
          createdAt: Date.now(),
        },
        60 * 60 * 1000,
      );

      return { data: { listenKey }, success: true, message: 'Listen key created successfully' };
    } catch (err) {
      this.logger.error('Error creating listen key', err);
      return { data: null, success: false, message: 'Failed to create listen key' };
    }
  }
}
</file>

<file path="src/application/commands/account/update-user-stream-key.command.ts">
import { Injectable } from '@nestjs/common';
import { CommandHandler, ICommandHandler } from '@nestjs/cqrs';
import { IListenKey } from 'src/common/interface/listen-key-cache';
import { IUseCaseResponse } from 'src/common/interface/response/interface/response.result.interface';
import { AppException } from 'src/core/exceptions/app.exception';
import { ICacheManager } from 'src/core/interfaces/cache-manager.interface';
import { IApiRequestPayload } from 'src/presentation/dtos/api-key/api-key.response';

export class UpdateUserStreamCommand {
  constructor(
    public readonly listenKey: string,
    public readonly apiReqPayload: IApiRequestPayload,
  ) {
    if (!listenKey) {
      throw new AppException('ListenKey is required');
    }
  }
}

@Injectable()
@CommandHandler(UpdateUserStreamCommand)
export class UpdateUserStreamCommandHandler
  implements ICommandHandler<UpdateUserStreamCommand, IUseCaseResponse<boolean>>
{
  constructor(private readonly cacheManager: ICacheManager) {}

  async execute(command: UpdateUserStreamCommand): Promise<IUseCaseResponse<boolean>> {
    const { listenKey } = command;

    const apiKey = command.apiReqPayload.apiKey;
    const existingData = await this.cacheManager.get<IListenKey>(`listen:${apiKey}`);
    if (!existingData) {
      throw new AppException('ListenKey not found or already expired', 404);
    }

    if (existingData.listenKey !== listenKey) {
      throw new AppException('Listen  key doesnt match');
    }
    const updatedData = { ...existingData, createdAt: Date.now() };
    await this.cacheManager.set(`listen:${apiKey}`, updatedData, 60 * 60 * 1000);

    return { success: true, data: true, message: 'Listen Key updated successfully' };
  }
}
</file>

<file path="src/application/queries/market-data/get-last-transaction-price.ts">
import { IQueryHandler, QueryHandler } from '@nestjs/cqrs';
import { IUseCaseResponse } from 'src/common/interface/response/interface/response.result.interface';
import { AppException } from 'src/core/exceptions/app.exception';
import { NatsService } from 'src/infrastructure/messaging/nats/nats.service';
export class GetLastTransactionPriceQuery {
  constructor(public readonly symbol: string) {
    if (!symbol) {
      throw new AppException('Symbol cannot be empty', 400);
    }
  }
}

@QueryHandler(GetLastTransactionPriceQuery)
export class GetLastTransactionPriceQueryHandler
  implements IQueryHandler<GetLastTransactionPriceQuery, IUseCaseResponse<{ symbol: string; price: number }>>
{
  constructor(private readonly natsService: NatsService) {}

  async execute(query: GetLastTransactionPriceQuery): Promise<IUseCaseResponse<{ symbol: string; price: number }>> {
    const { symbol } = query;

    const natsResponse = await this.natsService.send('get_latest_market_price', { symbol });

    if (!natsResponse.success) {
      throw new AppException(
        natsResponse.message || 'Failed to fetch the latest market price',
        natsResponse.statusCode || 400,
      );
    }

    return {
      success: true,
      message: 'Latest market price fetched successfully',
      data: {
        symbol: symbol,
        price: natsResponse.data.price,
      },
    };
  }
}
</file>

<file path="src/application/queries/market-data/get-recent-trade-query.ts">
import { IQueryHandler, QueryHandler } from '@nestjs/cqrs';
import { IUseCaseResponse } from 'src/common/interface/response/interface/response.result.interface';
import { AppException } from 'src/core/exceptions/app.exception';
import { ITradeTransactionHistoryRepository } from 'src/core/repositories/trade-transation-history.repository.abstract';
import { RecentTradeResponse } from 'src/presentation/dtos/response/recent-trade.response';

export class GetRecentTradesQuery {
  constructor() {}
}

@QueryHandler(GetRecentTradesQuery)
export class GetRecentTradesQueryHandler
  implements IQueryHandler<GetRecentTradesQuery, IUseCaseResponse<RecentTradeResponse[]>>
{
  constructor(private readonly tradeTransactionRepo: ITradeTransactionHistoryRepository) {}

  async execute(): Promise<IUseCaseResponse<RecentTradeResponse[]>> {
    // Fetch recent trades from the repository
    const trades = await this.tradeTransactionRepo.getRecentTrades();

    if (!trades) {
      throw new AppException('Failed to fetch recent trades', 500);
    }

    return {
      success: true,
      message: 'Recent trades fetched successfully',
      data: trades.map((trade) => ({
        id: trade._id as string,
        price: trade.price.toFixed(8),
        quoteQuantity: trade.total.toFixed(8),
        quantity: trade.amount.toFixed(8),
        time: trade.created_date.toISOString(),
      })),
    };
  }
}
