import { Body, Controller, Post, Put, Req, UseGuards } from '@nestjs/common';
import { CommandBus } from '@nestjs/cqrs';
import { Request } from 'express';
import { CreateUserStreamCommand } from 'src/application/commands/account/create-user-stream-key.command';
import { UpdateUserStreamCommand } from 'src/application/commands/account/update-user-stream-key.command';
import { IUseCaseResponse } from 'src/common/interface/response/interface/response.result.interface';
import { CoreApiResponse } from 'src/core/api/core-api-response';
import { IApiRequestPayload } from 'src/presentation/dtos/api-key/api-key.response';
import { AuthGuard } from 'src/presentation/guards/auth.guard';

@Controller('v1/account')
export class AccountController {
  constructor(private readonly commandBus: CommandBus) {}

  @Post('user-stream')
  @UseGuards(AuthGuard)
  async createUserStream(@Req() req: Request) {
    const result = await this.commandBus.execute<CreateUserStreamCommand, IUseCaseResponse<{ listenKey: string }>>(
      new CreateUserStreamCommand(req['loginPayload'] as IApiRequestPayload),
    );
    return CoreApiResponse.success(result);
  }

  @Put('user-stream')
  @UseGuards(AuthGuard)
  async updateUserStream(@Body('listenKey') listenKey: string, @Req() req: Request) {
    const result = await this.commandBus.execute<UpdateUserStreamCommand, IUseCaseResponse<boolean>>(
