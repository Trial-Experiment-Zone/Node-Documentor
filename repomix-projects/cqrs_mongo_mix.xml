import { Injectable } from '@nestjs/common';
import { ITradePair } from '@onexchainorg/userpanel-schemas/interfaces';
import { streamDataTypes } from 'src/common/constants/websocket.constants';
import { IUseCaseResponse } from 'src/common/interface/response/interface/response.result.interface';
import { ITradePairRepository } from 'src/core/repositories/trade-pair.repository.abstract';

@Injectable()
export class StreamValidateService {
  constructor(private readonly tradePairRepository: ITradePairRepository) {}
  async validateStreamName(streamName: string): Promise<IUseCaseResponse<ITradePair>> {
    const dataType = streamName?.split('@')[1];
    if (!streamDataTypes.includes(dataType)) {
      return { message: 'Invalid stream data type', success: false };
    }

    const symbol = streamName?.split('@')[0]?.replace('_', '/')?.toUpperCase();
    if (!symbol) {
      return { message: 'Invalid stream name', success: false };
    }

    const tradePair = await this.tradePairRepository.getTradePairBySymbol(symbol);
    if (!tradePair) {
      return { data: tradePair, message: 'Invalid trade pair', success: false };
    }
    return { data: tradePair, message: 'Valid trade pair', success: true };
  }
}
