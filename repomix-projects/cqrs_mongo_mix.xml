import { Injectable } from '@nestjs/common';
import { OrderType } from '@onexchainorg/shared/matching-engine';
import { ITradeOrder } from '@onexchainorg/userpanel-schemas/interfaces';
import { IUseCaseResponse } from 'src/common/interface/response/interface/response.result.interface';
import { ICreateOrderInput } from 'src/core/interfaces/place-order.interface';
import { CreateLimitOrderStrategy } from 'src/core/strategies/create-order/create-limit-order.strategy';
import { CreateMarketOrderStrategy } from 'src/core/strategies/create-order/create-market-order.strategy';
import { CreateStopLimitOrderStrategy } from 'src/core/strategies/create-order/create-stop-limit-order.strategy';
import { IApiRequestPayload } from 'src/presentation/dtos/api-key/api-key.response';
@Injectable()
export class CreateOrderFactoryService {
  constructor(
    private readonly limitOrderStrat: CreateLimitOrderStrategy,
    private readonly marketOrderStrat: CreateMarketOrderStrategy,
    private readonly stopLimitStrat: CreateStopLimitOrderStrategy,
  ) {}

  async handleOrder(
    orderDto: ICreateOrderInput,
    loginPayload: IApiRequestPayload,
  ): Promise<IUseCaseResponse<ITradeOrder | null>> {
    let data: IUseCaseResponse<ITradeOrder | null> = { data: null, success: false, message: '' };
    switch (orderDto.type) {
      case OrderType.limit:
        data = await this.limitOrderStrat.execute(orderDto, loginPayload);
        break;
      case OrderType.market:
        data = await this.marketOrderStrat.execute(orderDto, loginPayload);
        break;
      case OrderType.stop_limit:
        data = await this.stopLimitStrat.execute(orderDto, loginPayload);
        break;
      default:
        data.message = 'Invalid order type';
        return data;
    }

    return data;
  }
}
</file>

