<file path="src/presentation/modules/websocket/websocket.gateway.ts">
import {
  WebSocketGateway as NestWebSocketGateway,
  OnGatewayConnection,
  OnGatewayDisconnect,
  OnGatewayInit,
  SubscribeMessage,
  WebSocketServer,
} from '@nestjs/websockets';
import { plainToInstance } from 'class-transformer';
import { validate } from 'class-validator';
import { Namespace, Socket } from 'socket.io';
import { formatValidationErrors } from 'src/common/error-formatter/validation-error-reducer';
import { WebsocketChannelRoom } from 'src/core/value-ojects/websocket-channel.vo';
import { LoggerService } from 'src/infrastructure/logger/logger.service';
import { SubscribeChannelDto, UnSubscribeChannelDto } from 'src/presentation/dtos/websocket/subscribe-channel.dto';
import { WebSocketErrRes, WebSocketRes } from '../../dtos/response/websocket.response';
import { WebSocketRoomService } from './services/websocket-room.service';
import { WebSocketService } from './services/websocket.service';

@NestWebSocketGateway({
  cors: {
    origin: '*',
  },
  namespace: '/stream',
})
export class WebSocketGateway implements OnGatewayInit, OnGatewayConnection, OnGatewayDisconnect {
  @WebSocketServer() namespace: Namespace;

  constructor(
    private readonly webSocketService: WebSocketService,
    private readonly logger: LoggerService,
    private readonly roomService: WebSocketRoomService,
  ) {
    this.logger.setContext(WebSocketGateway.name);
  }

  /**
   * Called after the gateway is initialized
   */
  afterInit(): void {
    this.webSocketService.setServer(this.namespace);
    this.logger.log('WebSocket Gateway initialized');
  }

  /**
   * Called when a client connects
   */
  async handleConnection(client: Socket): Promise<void> {
    try {
      this.logger.log(`Client connected: ${client.id}`);
    } catch (error) {
      this.logger.error(`Error handling connection for client ${client.id}: ${error.message}`, error.stack);
    }
  }

  /**
   * Called when a client disconnects
   */
  handleDisconnect(client: Socket): void {
    try {
      this.logger.log(`Client disconnected: ${client.id}`);
    } catch (error) {
      this.logger.error(`Error handling disconnect for client ${client.id}: ${error.message}`, error.stack);
    }
  }

  /**
   * Subscribe to a specific stream
   */
  @SubscribeMessage('subscribe')
  async handleStreamSubscribe(client: Socket, body: SubscribeChannelDto) {
    const dto = plainToInstance(SubscribeChannelDto, body);
    const validatedDto = await validate(dto);
    if (validatedDto.length) {
      const errors = formatValidationErrors(validatedDto);
      return new WebSocketErrRes(errors.message, errors.error);
    }
    const joinedRoom = await this.roomService.joinRoom(client, dto);
    if (!joinedRoom.success) return new WebSocketErrRes(joinedRoom.message, joinedRoom.errors);
    return new WebSocketRes('subscribe', joinedRoom.data);
  }

  /**
   * Unsubscribe from a specific stream
   */
  @SubscribeMessage('unsubscribe')
  async handleStreamUnsubscribe(client: Socket, body: UnSubscribeChannelDto) {
    const dto = plainToInstance(UnSubscribeChannelDto, body);
    const validatedDto = await validate(dto);
    if (validatedDto.length) {
      const errors = formatValidationErrors(validatedDto);
      return new WebSocketErrRes(errors.message, errors.error);
    }
    const wsChannel = WebsocketChannelRoom.createMarketChannel(dto.channel, dto.symbol);
    const leaveRoomRes = await this.roomService.removeClientFromRoom(client, wsChannel.room);
    if (!leaveRoomRes.success) return new WebSocketErrRes(leaveRoomRes.message, leaveRoomRes.errors);
    return new WebSocketRes('unsubscribe', leaveRoomRes.data);
  }
}
</file>

