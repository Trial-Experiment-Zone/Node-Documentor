<file path="src/infrastructure/scheduler/price-tick/price-tick.scheduler.ts">
import { Injectable } from '@nestjs/common';
import { Cron, CronExpression } from '@nestjs/schedule';
import { IPriceProvider } from 'src/application/services/IPriceProvider';
import { Channels } from 'src/common/constants/channels.constants';
import { ITradePairRepository } from 'src/core/repositories/trade-pair.repository.abstract';
import { WebsocketChannelRoom } from 'src/core/value-ojects/websocket-channel.vo';
import { LoggerService } from 'src/infrastructure/logger/logger.service';
import { WebSocketService } from 'src/presentation/modules/websocket/services/websocket.service';

@Injectable()
export class PriceTickScheduler {
  constructor(
    private readonly priceProvider: IPriceProvider,
    private readonly logger: LoggerService,
    private readonly tradePairRepository: ITradePairRepository,
    private readonly websocketService: WebSocketService,
  ) {
    this.logger.setContext(PriceTickScheduler.name);
  }

  @Cron(CronExpression.EVERY_10_SECONDS)
  async handleCron() {
    const symbols = [
      'ETH/BTC',
      'LTC/BTC',
      'MATIC/BTC',
      'DOGE/BTC',
      'ADA/BTC',
      'SOL/BTC',
      'XRP/BTC',
      'ADA/ETH',
      'SOL/ETH',
      'ADA/USD',
      'DOGE/USD',
      'MATIC/USD',
      'SOL/USD',
      'XRP/USD',
    ];

    const prices = await this.priceProvider.getPrice(symbols);
    this.logger.debug({
      event: 'PRICE_TICK_SCHEDULER',
      message: `Last price updated for ${prices.map((p) => p.pair).join(', ')}`,
    });

    await this.tradePairRepository.bulkUpdateTradePrice(
      prices.map((p) => ({ ...p, updated_by: 'crypto_pcompare' })).filter((p) => p.price !== '0'),
    );

    for (const price of prices) {
      if (price.price === '0') continue;
      const channelRoom = WebsocketChannelRoom.createMarketChannel(Channels.ticker, price.pair.replace('/', '_'));
      this.websocketService.broadcastMarketDataEvent(channelRoom.room, {
        channel: Channels.ticker,
        data: {
          symbol: price.pair.replace('/', '_'),
          price: parseFloat(price.price),
        },
      });
    }
  }
}
</file>

<file path="src/infrastructure/services/cryptocompare-price-provider.service.ts">
import { Injectable, OnModuleDestroy, OnModuleInit } from '@nestjs/common';
import { IPriceProvider } from 'src/application/services/IPriceProvider';
import WebSocket from 'ws';

@Injectable()
export class CryptoComparePriceProviderService implements IPriceProvider, OnModuleInit, OnModuleDestroy {
  private readonly API_KEY = process.env.CRYPTO_COMPARE_API_KEY;
  private readonly BASE_URL = 'https://data-api.coindesk.com';
  private readonly WS_URL = 'wss://data-streamer.coindesk.com';
  private ws: WebSocket | null = null;
  private isConnected = false;
  private reconnectAttempts = 0;
  private readonly MAX_RECONNECT_ATTEMPTS = 5;
  private readonly RECONNECT_DELAY = 5000; // 5 seconds
  private isConnecting = false; // Add flag to prevent multiple connection attempts

  private readonly SYMBOLS = {
    'ETH/BTC': '0',
    'LTC/BTC': '0',
    'MATIC/BTC': '0',
    'DOGE/BTC': '0',
    'ADA/BTC': '0',
    'SOL/BTC': '0',
    'XRP/BTC': '0',
    'ADA/ETH': '0',
    'SOL/ETH': '0',
    'ADA/USD': '0',
    'DOGE/USD': '0',
    'MATIC/USD': '0',
    'SOL/USD': '0',
    'XRP/USD': '0',
  };

  constructor() {}

  async onModuleInit() {
    await this.updatePrice(Object.keys(this.SYMBOLS));
  }

  async onModuleDestroy() {
    await this.disconnectWebSocket();
  }

  private async connectWebSocket() {
    // Prevent multiple simultaneous connection attempts
    if (this.isConnecting || (this.ws && this.isConnected)) {
      return;
    }

    try {
      this.isConnecting = true;

      // Ensure any existing connection is properly closed
      await this.disconnectWebSocket();

      this.ws = new WebSocket(this.WS_URL + `?api_key=${this.API_KEY}`);

      // Set up connection timeout
      const connectionTimeout = setTimeout(() => {
        if (!this.isConnected) {
          console.error('WebSocket connection timeout');
          this.disconnectWebSocket();
        }
      }, 10000); // 10 second timeout

      this.ws.on('open', () => {
        clearTimeout(connectionTimeout);
        console.log('WebSocket connected');
        this.isConnected = true;
        this.reconnectAttempts = 0;
        this.isConnecting = false;

        // Subscribe to all symbols after successful connection
        this.updatePrice(Object.keys(this.SYMBOLS)).catch((error) => {
          console.error('Error subscribing to symbols:', error);
        });
      });

      this.ws.on('message', (data: string) => {
        try {
          const message = JSON.parse(data);

          // Handle error messages
          if (message.STATUS_CODE === '1008') {
            console.error('WebSocket error:', message.MESSAGE);
            this.disconnectWebSocket();
            return;
          }

          if (message.TYPE === '959' && message.INSTRUMENT) {
            const formattedSymbol = message.INSTRUMENT.replace('-', '/');
            if (this.SYMBOLS.hasOwnProperty(formattedSymbol)) {
              this.SYMBOLS[formattedSymbol] = message.PRICE.toString();
            }
          }
        } catch (error) {
          console.error('Error processing WebSocket message:', error);
        }
      });

      this.ws.on('close', () => {
        clearTimeout(connectionTimeout);
        console.log('WebSocket disconnected');
        this.isConnected = false;
        this.isConnecting = false;
        this.handleReconnect();
      });

      this.ws.on('error', (error) => {
        clearTimeout(connectionTimeout);
        console.error('WebSocket error:', error);
        this.isConnected = false;
        this.isConnecting = false;
        this.handleReconnect();
      });
    } catch (error) {
      console.error('Error in connectWebSocket:', error);
      this.isConnecting = false;
      this.handleReconnect();
    }
  }

  private async handleReconnect() {
    if (this.reconnectAttempts < this.MAX_RECONNECT_ATTEMPTS) {
      this.reconnectAttempts++;
      console.log(`Attempting to reconnect (${this.reconnectAttempts}/${this.MAX_RECONNECT_ATTEMPTS})...`);
      await new Promise((resolve) => setTimeout(resolve, this.RECONNECT_DELAY));
      await this.connectWebSocket();
    } else {
      console.error('Max reconnection attempts reached');
    }
  }

  private async disconnectWebSocket() {
    if (this.ws) {
      try {
        // Remove all listeners to prevent memory leaks
        this.ws.removeAllListeners();

        // Close the connection
        this.ws.close();
      } catch (error) {
        console.error('Error closing WebSocket:', error);
      } finally {
        this.ws = null;
        this.isConnected = false;
        this.isConnecting = false;
      }
    }
  }

  async updatePrice(symbols: string[]): Promise<void> {
    if (!this.ws || !this.isConnected) {
      console.log('WebSocket not connected, attempting to connect...');
      await this.connectWebSocket();
      // Wait for connection to be established
      await new Promise((resolve) => setTimeout(resolve, 1000));
    }

    if (this.ws && this.isConnected) {
      const formattedSymbols = symbols.map((symbol) => symbol.replace('/', '-'));
      const subscribeMessage = {
        action: 'SUBSCRIBE',
        type: 'spot_v1_latest_tick',
        groups: ['VALUE', 'CURRENT_HOUR'],
        market: 'coinbase',
        instruments: formattedSymbols,
      };

      try {
        this.ws.send(JSON.stringify(subscribeMessage));
      } catch (error) {
        console.error('Error sending subscription message:', error);
        // Attempt to reconnect if sending fails
        await this.connectWebSocket();
      }
    }
  }

  async getPrice(symbols: string[]): Promise<{ price: string; pair: string }[]> {
    const results: { price: string; pair: string }[] = [];

    for (const symbol of symbols) {
      if (this.SYMBOLS.hasOwnProperty(symbol)) {
        results.push({
          pair: symbol,
          price: this.SYMBOLS[symbol],
        });
      }
    }

    return results;
  }
}
</file>

