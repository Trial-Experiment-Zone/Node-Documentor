<file path="src/core/services/trade/trade-balance.service.ts">
import { Injectable } from '@nestjs/common';
import { OrderSide, Trade } from '@onexchainorg/shared/matching-engine';
import { IWallet } from '@onexchainorg/userpanel-schemas/interfaces';
import { ICalculateFeeResponse } from 'src/common/interface/calculate-fee.response';
import { IBalanceUpdateResponse } from 'src/common/interface/debit-credit-balance.response';
import { IUseCaseResponse } from 'src/common/interface/response/interface/response.result.interface';
import { ICurrencyRepository } from 'src/core/repositories/currency.repository.abstract';
import { ITradeOrderRepository } from 'src/core/repositories/trade-order.repository.abstract';
import { IUserWalletRepository, IWalletBalance } from 'src/core/repositories/user-wallet.repository.abstract';

@Injectable()
export class TradeBalanceService {
  constructor(
    private readonly userWallet: IUserWalletRepository,
    private readonly tradeOrderRepo: ITradeOrderRepository,
    private readonly currencyRepo: ICurrencyRepository,
  ) {}

  async checkUserBalance(
    userId: string,
    currency: string,
    amount: number,
  ): Promise<IUseCaseResponse<IWalletBalance | null>> {
    const balance = await this.userWallet.getUserBalanceByCurrency(userId, currency);
    if (!balance || !balance.spotBalance) {
      return { data: null, message: 'User balance not found', success: false };
    }

    if (+balance.spotBalance.toFixed(8) >= +amount.toFixed(8)) {
      return { data: balance, message: 'Enough balance', success: true };
    }

    return { data: balance, message: 'Not Enough Balance', success: false };
  }

  async calculateOrderAmount(side: OrderSide, price: number, quantity: number): Promise<IUseCaseResponse<number>> {
    /**
     * if type is market, then calculate the predicted amount
     */
    if (side === OrderSide.buy) {
      return { data: price * quantity, message: 'Success', success: true };
    } else {
      return { data: quantity, message: 'Success', success: true };
    }
  }

  async lockUserBalance(userId: string, currency: string, amount: number): Promise<IUseCaseResponse<IWallet | null>> {
    const wallet = await this.userWallet.lockUserBalance(userId, currency, amount);
    return { data: wallet, message: wallet ? 'Success' : 'Failed to lock balance', success: !!wallet };
  }

  async calculateMakerFee(
    trades: Trade[],
    pair: string,
    side: OrderSide,
  ): Promise<IUseCaseResponse<ICalculateFeeResponse[] | null>> {
    if (!trades || trades.length === 0) return { data: null, message: 'No trades found', success: true };
    const balanceUpdate: ICalculateFeeResponse[] = [];
    const orderDetails = await this.tradeOrderRepo.getMakerTakerOrders(
      trades.map((trade) => trade.orderId),
      pair.split('_').join('/'),
    );
    if (!orderDetails || orderDetails.length === 0)
      return { data: null, message: 'No order details found', success: false };

    const [baseCurrency, quoteCurrency] = pair.split('_');

    const currencyDetail = await this.currencyRepo.getCurrencyByCode(
      side === OrderSide.buy ? baseCurrency : quoteCurrency,
    );

    if (!currencyDetail) return { data: null, message: 'Currency not found', success: false };

    const makerFeePercent = currencyDetail.maker_fee;

    for (const trade of trades) {
      const order = orderDetails.find((order) => order.eng_order_id === trade.orderId);
      if (!order) continue;
      const tradeTotal = +trade.price * +trade.quantity;
      let fees = 0;
      if (order.trade_type === OrderSide.sell) {
        fees = (tradeTotal * makerFeePercent) / 100;
        balanceUpdate.push({
          userAmount: tradeTotal - fees,
          adminFee: fees,
          orderId: order._id.toString(),
          currency: quoteCurrency,
          lockedCurrency: baseCurrency,
          lockedAmount: +trade.quantity,
          tradePrice: +trade.price,
          tradeTotal: tradeTotal,
          tradeQuantity: +trade.quantity,
          userId: order.user_id.toString(),
          engOrderId: trade.orderId,
          orderSide: OrderSide.sell,
          adminFeePercent: makerFeePercent,
          orderType: order.order_type,
          symbol: order.pair,
        });
      } else {
        fees = (+trade.quantity * makerFeePercent) / 100;
        balanceUpdate.push({
          userAmount: +trade.quantity - fees,
          adminFee: fees,
          orderId: order._id.toString(),
          currency: baseCurrency,
          lockedCurrency: quoteCurrency,
          tradePrice: +trade.price,
          lockedAmount: +trade.price * +trade.quantity,
          tradeTotal: tradeTotal,
          tradeQuantity: +trade.quantity,
          userId: order.user_id.toString(),
          engOrderId: trade.orderId,
          orderSide: OrderSide.buy,
          adminFeePercent: makerFeePercent,
          orderType: order.order_type,
          symbol: order.pair,
        });
      }
    }

    return { data: balanceUpdate, message: 'Success', success: true };
  }

  async calculateTakerFee(
    trades: Trade[],
    pair: string,
    side: OrderSide,
  ): Promise<IUseCaseResponse<ICalculateFeeResponse[] | null>> {
    const balanceUpdate: ICalculateFeeResponse[] = [];
    const orderDetails = await this.tradeOrderRepo.getMakerTakerOrders(
      trades.map((trade) => trade.orderId),
      pair.split('_').join('/'),
    );

    if (!orderDetails || orderDetails.length === 0)
      return { data: null, message: 'No order details found', success: false };

    const [baseCurrency, quoteCurrency] = pair.split('_');

    const currencyDetail = await this.currencyRepo.getCurrencyByCode(
      side === OrderSide.buy ? baseCurrency : quoteCurrency,
    );

    if (!currencyDetail) return { data: null, message: 'Currency not found', success: false };

    const takerFeePercent = currencyDetail.taker_fee;

    for (const trade of trades) {
      const order = orderDetails.find((order) => order.eng_order_id === trade.orderId);
      if (!order) continue;
      const tradeTotal = +trade.price * +trade.quantity;
      let fees = 0;
      if (order.trade_type === OrderSide.sell) {
        fees = (tradeTotal * takerFeePercent) / 100;
        balanceUpdate.push({
          userAmount: tradeTotal - fees,
          adminFee: fees,
          orderId: order._id.toString(),
          currency: quoteCurrency,
          lockedCurrency: baseCurrency,
          lockedAmount: +trade.quantity,
          tradeQuantity: +trade.quantity,
          tradePrice: +trade.price,
          tradeTotal: tradeTotal,
          userId: order.user_id.toString(),
          engOrderId: trade.orderId,
          orderSide: OrderSide.sell,
          adminFeePercent: takerFeePercent,
          orderType: order.order_type,
          symbol: order.pair,
        });
      } else {
        fees = (+trade.quantity * takerFeePercent) / 100;
        balanceUpdate.push({
          userAmount: +trade.quantity - fees,
          adminFee: fees,
          orderId: order._id.toString(),
          currency: baseCurrency,
          lockedCurrency: quoteCurrency,
          lockedAmount: +trade.price * +trade.quantity,
          tradeTotal: tradeTotal,
          tradePrice: +trade.price,
          userId: order.user_id.toString(),
          engOrderId: trade.orderId,
          tradeQuantity: +trade.quantity,
          orderSide: OrderSide.buy,
          adminFeePercent: takerFeePercent,
          orderType: order.order_type,
          symbol: order.pair,
        });
      }
    }

    return { data: balanceUpdate, message: 'Success', success: true };
  }

  async bulkCreditUserBalance(data: ICalculateFeeResponse[]): Promise<IUseCaseResponse<IBalanceUpdateResponse | null>> {
    const res = await this.userWallet.bulkCreditUserBalance(data);
    if (!res) return { data: null, message: 'Failed to credit user balance', success: false };
    const updatedBalance = await this.userWallet.getUserBalanceByCurrency(data[0].userId, data[0].currency);
    if (!updatedBalance) return { data: null, message: 'Failed to get user balance', success: false };
    return {
      data: {
        currency: data[0].currency,
        amount: updatedBalance.spotBalance,
        inorder: updatedBalance.inorder,
      },
      message: 'Success',
      success: true,
    };
  }

  async bulkDebitLockedBalance(data: ICalculateFeeResponse[]): Promise<IUseCaseResponse<boolean | null>> {
    const res = await this.userWallet.bulkDebitLockedBalance(data);
    if (!res) return { data: null, message: 'Failed to update locked balance', success: false };
    return { data: res, message: 'Success', success: true };
  }

  async refundLockedBalance(
    userId: string,
    currency: string,
    amount: number,
  ): Promise<IUseCaseResponse<IWallet | null>> {
    const res = await this.userWallet.refundLockedBalance(userId, currency, amount);
    if (!res) return { data: null, message: 'Failed to refund user balance', success: false };
    return { data: res, message: 'Success', success: true };
  }
}
