import { Injectable, OnModuleInit } from '@nestjs/common';
import { AggBuySellTrade } from '@onexchainorg/shared/matching-engine';
import { ICacheManager } from 'src/core/interfaces/cache-manager.interface';
import { LoggerService } from 'src/infrastructure/logger/logger.service';

@Injectable()
export class RecentTradesService implements OnModuleInit {
  private readonly TRADES_PER_SYMBOL = 100;
  private readonly REDIS_KEY_PREFIX = 'recent_trades:';
  private tradeMap: Map<string, AggBuySellTrade[]> = new Map();
  private static instanceCount = 0;

  constructor(
    private readonly logger: LoggerService,
    private readonly cacheManager: ICacheManager,
  ) {
    RecentTradesService.instanceCount++;
    this.logger.setContext(RecentTradesService.name);
    this.logger.log({
      event: 'SERVICE_INITIALIZED',
      instances: RecentTradesService.instanceCount,
      message: 'RecentTradesService initialized',
    });
  }

  async onModuleInit(): Promise<void> {
    await this.loadTradesFromRedis();
  }

  private getRedisKey(symbol: string): string {
    return `${this.REDIS_KEY_PREFIX}${symbol.toLowerCase()}`;
  }

  private async loadTradesFromRedis(): Promise<void> {
    try {
      const keys = await this.cacheManager.keys(`${this.REDIS_KEY_PREFIX}*`);
      for (const key of keys) {
        const symbol = key.replace(this.REDIS_KEY_PREFIX, '');
        const trades = await this.cacheManager.get<AggBuySellTrade[]>(key);
        if (trades) {
          this.tradeMap.set(symbol, trades);
          this.logger.debug({
            event: 'TRADES_LOADED_FROM_REDIS',
            symbol,
            tradesCount: trades.length,
            message: `Loaded trades from Redis for ${symbol}`,
          });
        }
      }
    } catch (error) {
      this.logger.error({
        event: 'REDIS_LOAD_ERROR',
        error,
        message: 'Failed to load trades from Redis',
      });
    }
  }

  private async saveTradestoRedis(symbol: string, trades: AggBuySellTrade[]): Promise<void> {
    try {
      const key = this.getRedisKey(symbol);
      await this.cacheManager.set(key, trades);
      this.logger.debug({
        event: 'TRADES_SAVED_TO_REDIS',
        symbol,
        tradesCount: trades.length,
        message: `Saved trades to Redis for ${symbol}`,
      });
    } catch (error) {
      this.logger.error({
        event: 'REDIS_SAVE_ERROR',
        symbol,
        error,
        message: 'Failed to save trades to Redis',
      });
    }
  }

  async addTrade(trade: AggBuySellTrade): Promise<void> {
    const symbol = trade.symbol.toLocaleLowerCase();
    let trades = this.tradeMap.get(symbol);

    if (!trades) {
      trades = [];
      this.tradeMap.set(symbol, trades);
      this.logger.log({
        event: 'NEW_SYMBOL_ADDED',
        symbol,
        message: 'Started tracking new trading pair',
      });
    }

    // Add new trade at the beginning
    trades.unshift(trade);

    // Keep only the last N trades
    if (trades.length > this.TRADES_PER_SYMBOL) {
      trades.pop();
    }

    // Save to Redis
    await this.saveTradestoRedis(symbol, trades);

    this.logger.debug({
      event: 'TRADE_ADDED',
      symbol,
      tradeId: trade.tradeId,
      price: trade.price,
      quantity: trade.quantity,
      totalTrades: trades.length,
      message: `Trade processed for ${symbol}`,
    });
  }

  async getRecentTrades(symbol: string, limit: number = this.TRADES_PER_SYMBOL): Promise<AggBuySellTrade[]> {
    const trades = this.tradeMap.get(symbol.toLowerCase()) || [];
    this.logger.debug({
      event: 'TRADES_RETRIEVED',
      symbol,
      requestedLimit: limit,
      returnedTrades: Math.min(trades.length, limit),
      message: `Recent trades retrieved for ${symbol}`,
    });
    return trades.slice(0, limit);
  }

  getAllSymbolTrades(): Map<string, AggBuySellTrade[]> {
    const allTrades = new Map(this.tradeMap);
    this.logger.debug({
      event: 'ALL_TRADES_RETRIEVED',
      symbolCount: allTrades.size,
      symbols: Array.from(allTrades.keys()),
      message: 'All symbol trades retrieved',
    });
    return allTrades;
  }

  getTrackingStats(): { symbols: string[]; totalTrades: number } {
    const symbols = Array.from(this.tradeMap.keys());
    const totalTrades = Array.from(this.tradeMap.values()).reduce((sum, trades) => sum + trades.length, 0);

    this.logger.debug({
      event: 'STATS_RETRIEVED',
      symbolCount: symbols.length,
      totalTrades,
      symbols,
      message: 'Trading statistics retrieved',
    });

    return { symbols, totalTrades };
  }
}
</file>

