import { Injectable } from '@nestjs/common';
import { Socket } from 'socket.io';
import { Channels } from 'src/common/constants/channels.constants';
import { IUseCaseResponse } from 'src/common/interface/response/interface/response.result.interface';
import { IUserApiKeyRepository } from 'src/core/repositories/user-api-key.repository.abstract';
import { WebsocketChannelRoom } from 'src/core/value-ojects/websocket-channel.vo';
import { LoggerService } from 'src/infrastructure/logger/logger.service';
import { SubscribeChannelDto } from 'src/presentation/dtos/websocket/subscribe-channel.dto';

@Injectable()
export class WebSocketRoomService {
  constructor(
    private readonly logger: LoggerService,
    private readonly apiKeyRepository: IUserApiKeyRepository,
  ) {
    this.logger.setContext(WebSocketRoomService.name);
  }

  async joinRoom(client: Socket, dto: SubscribeChannelDto): Promise<IUseCaseResponse<any>> {
    if (!dto.channel || !Channels.hasOwnProperty(dto.channel)) return { success: false, message: 'Invalid Channel' };
    switch (dto.channel) {
      case Channels.book:
        var channel = WebsocketChannelRoom.createMarketChannel(Channels.book, dto.symbol);
        await client.join(channel.room);
        return {
          success: true,
          message: `Client Subscribed to ${Channels.book} channel`,
          data: { channel: Channels.book, symbol: dto.symbol },
        };
      case Channels.ohlc:
        var channel = WebsocketChannelRoom.createMarketChannelWithInterval(Channels.ohlc, dto.symbol, dto.interval);
        await client.join(channel.room);
        return {
          success: true,
          message: `Client Subscribed to ${Channels.ohlc} channel`,
          data: { channel: Channels.ohlc, symbol: dto.symbol, interval: dto.interval },
        };
      case Channels.ticker:
        var channel = WebsocketChannelRoom.createMarketChannel(Channels.ticker, dto.symbol);
        await client.join(channel.room);
        return {
          success: true,
          message: `Client Subscribed to ${Channels.ticker} channel`,
          data: { channel: Channels.ticker, symbol: dto.symbol },
        };
      case Channels.trade:
        var channel = WebsocketChannelRoom.createMarketChannel(Channels.trade, dto.symbol);
        await client.join(channel.room);
        return {
          success: true,
          message: `Client Subscribed to ${Channels.trade} channel`,
          data: { channel: Channels.trade, symbol: dto.symbol },
        };
      case Channels.execution:
        const dbUser = await this.apiKeyRepository.findUserByApiKey(dto.apiKey);
        if (!dbUser) return { success: false, message: `Invalid api key` };
        var channel = WebsocketChannelRoom.createUserChannel(Channels.execution, dbUser._id as string);
        await client.join(channel.room);
        return {
          success: true,
          message: `Client Subscribed to ${Channels.execution} channel`,
          data: { channel: Channels.execution },
        };
      case Channels.balances:
        const user = await this.apiKeyRepository.findUserByApiKey(dto.apiKey);
        if (!user) return { success: false, message: `Invalid api key` };
        var channel = WebsocketChannelRoom.createUserChannel(Channels.balances, user._id as string);
        await client.join(channel.room);
        return {
          success: true,
          message: `Client Subscribed to ${Channels.balances} channel`,
          data: { channel: Channels.balances },
        };
    }
  }

  async removeClientFromRoom(client: Socket, room: string): Promise<IUseCaseResponse<any>> {
    await client.leave(room);
    return { success: true, message: `client unsubcribed successfully from ${room}`, data: true };
  }
}
</file>

