<file path="src/infrastructure/throttler/throttler.service.ts">
import { Injectable } from '@nestjs/common';
import { ConfigService } from '@nestjs/config';
import { AppException } from 'src/core/exceptions/app.exception';
import { IThrottlerService } from 'src/core/services/abstract/throttler.service';
import { ThrottleLimit } from 'src/core/value-ojects/throttle-limit.vo';

@Injectable()
export class ThrottlerService implements IThrottlerService {
  private readonly storage: Map<string, { count: number; ttl: number }> = new Map();

  constructor(private readonly configService: ConfigService) {}

  async isAllowed(identifier: string, throttleLimit: ThrottleLimit = this.getDefaultThrottleLimit()): Promise<boolean> {
    if (!identifier) {
      throw new AppException('Invalid Identifier');
    }

    this.cleanupExpiredRecords();

    const record = this.storage.get(identifier);
    if (!record) {
      return true;
    }

    const now = Date.now();
    if (now > record.ttl) {
      this.storage.delete(identifier);

      return true;
    }

    return record.count < throttleLimit.getLimit;
  }

  async trackRequest(identifier: string, throttleLimit: ThrottleLimit = this.getDefaultThrottleLimit()): Promise<void> {
    if (!identifier) {
      throw new AppException('Invalid Identifier');
    }

    this.cleanupExpiredRecords();

    const now = Date.now();
    const record = this.storage.get(identifier);

    if (!record || now > record.ttl) {
      this.storage.set(identifier, {
        count: 1,
        ttl: now + throttleLimit.getTtl * 1000,
      });

      return;
    }

    if (record.count >= throttleLimit.getLimit) {
      throw new AppException(
        `Too many requests ${identifier}, please try again after ${Math.ceil((record.ttl - now) / 1000)} seconds`,
      );
    }

    this.storage.set(identifier, {
      count: record.count + 1,
      ttl: record.ttl,
    });
  }

  async getRemainingRequests(
    identifier: string,
    throttleLimit: ThrottleLimit = this.getDefaultThrottleLimit(),
  ): Promise<number> {
    if (!identifier) {
      throw new AppException('Invalid Identifier');
    }

    this.cleanupExpiredRecords();

    const record = this.storage.get(identifier);
    if (!record) {
      return throttleLimit.getLimit;
    }

    const now = Date.now();
    if (now > record.ttl) {
      this.storage.delete(identifier);

      return throttleLimit.getLimit;
    }

    return Math.max(0, throttleLimit.getLimit - record.count);
  }

  async resetThrottling(identifier: string): Promise<void> {
    if (!identifier) {
      throw new AppException('Invalid Identifier');
    }

    this.storage.delete(identifier);
  }

  private cleanupExpiredRecords(): void {
    const now = Date.now();
    this.storage.forEach((record, key) => {
      if (now > record.ttl) {
        this.storage.delete(key);
      }
    });
  }

  private getDefaultThrottleLimit(): ThrottleLimit {
    const ttl = this.configService.get<number>('throttler.ttl');
    const limit = this.configService.get<number>('throttler.limit');

    return ThrottleLimit.create(ttl, limit);
  }
}
</file>

<file path="src/presentation/guards/api-key.guard.ts">
import { CanActivate, ExecutionContext, Injectable } from '@nestjs/common';
import { Reflector } from '@nestjs/core';
import { IUserApiKey } from '@onexchainorg/userpanel-schemas/interfaces';
import { IS_PUBLIC_KEY } from 'src/common/decorators/public.decorator';
import { VALIDATE_SIGNATURE } from 'src/common/decorators/validate-signature.decorator';
import { generateCanonicalJson } from 'src/common/utils/canonical-json';
import { generateSignature } from 'src/common/utils/generate-signature';
import { AppException } from 'src/core/exceptions/app.exception';
import { IUserApiKeyRepository } from 'src/core/repositories/user-api-key.repository.abstract';

@Injectable()
export class ApiKeyGuard implements CanActivate {
  constructor(
    private reflector: Reflector,
    private readonly apiKeyRepository: IUserApiKeyRepository,
  ) {}

  async canActivate(context: ExecutionContext): Promise<boolean> {
    // Check if the route is marked as public
    const isPublic = this.reflector.getAllAndOverride<boolean>(IS_PUBLIC_KEY, [
      context.getHandler(),
      context.getClass(),
    ]);

    if (isPublic) {
      return true;
    }

    /**
     * if not public, check if the request has an api key and if it is valid
     * if not, throw an exception
     */
    const request = context.switchToHttp().getRequest();
    const apiKey = request.headers['x-api-key'];

    if (!apiKey) {
      throw new AppException('API key not found', 401);
    }

    const apikeyData: IUserApiKey = await this.apiKeyRepository.findByKey(apiKey);
    if (!apikeyData) {
      throw new AppException('Invalid API key', 401);
    }

    const checkSignature = this.reflector.getAllAndOverride<boolean>(VALIDATE_SIGNATURE, [
      context.getHandler(),
      context.getClass(),
    ]);

    if (checkSignature) {
      const body = request.body;
      const feSignatuer = request.headers['x-body-signature'];
      const newBody = generateCanonicalJson(body);
      const beSignature = generateSignature(newBody, apikeyData.api_secret);

      /**
       * throw error if signatuer is invalid. If valid proceed
       */
      if (feSignatuer !== beSignature) throw new AppException('Invalid Signature', 403);
    }

    request.loginPayload = {
      apiKey: apikeyData.api_key,
      apiSecret: apikeyData.api_secret || null,
      userId: apikeyData.user,
      permissions: apikeyData?.permissions?.map((permission) => permission.name),
    };

    return true;
  }
}
</file>

