import { Injectable, OnModuleInit } from '@nestjs/common';
import { AggBuySellTrade } from '@onexchainorg/shared/matching-engine';
import { LoggerService } from 'src/infrastructure/logger/logger.service';
import { OHLCService } from './ohlc.service';

@Injectable()
export class TradeQueueService implements OnModuleInit {
  private queue: AggBuySellTrade[] = [];
  private isProcessing = false;

  constructor(
    private readonly logger: LoggerService,
    private readonly ohlcService: OHLCService,
  ) {
    this.logger.setContext(TradeQueueService.name);
  }

  async onModuleInit() {
    // Nothing to initialize
  }

  async addTrade(trade: AggBuySellTrade): Promise<void> {
    this.queue.push(trade);
    this.logger.debug({
      event: 'TRADE_QUEUED',
      tradeId: trade.tradeId,
      symbol: trade.symbol,
      queueLength: this.queue.length,
    });

    if (!this.isProcessing) {
      await this.processQueue();
    }
  }

  private async processQueue(): Promise<void> {
    if (this.isProcessing || this.queue.length === 0) {
      return;
    }

    this.isProcessing = true;

    try {
      while (this.queue.length > 0) {
        const trade = this.queue.shift()!;

        this.logger.debug({
          event: 'PROCESSING_QUEUED_TRADE',
          tradeId: trade.tradeId,
          symbol: trade.symbol,
          remainingTrades: this.queue.length,
        });

        try {
          await this.ohlcService.processTrade(trade);
        } catch (error) {
          this.logger.error({
            event: 'TRADE_PROCESSING_ERROR',
            tradeId: trade.tradeId,
            symbol: trade.symbol,
            error,
          });
        }
      }
    } finally {
      this.isProcessing = false;
    }

    // Check if new trades were added while processing
    if (this.queue.length > 0) {
      await this.processQueue();
    }
  }
}
</file>

