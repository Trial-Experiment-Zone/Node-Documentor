import { Inject, Injectable } from '@nestjs/common';
import { OrderStatus } from '@onexchainorg/shared/matching-engine';
import { ITradeOrder } from '@onexchainorg/userpanel-schemas/interfaces';
import mongoose, { Model } from 'mongoose';
import { InjectableEntities } from 'src/application/commands/injectable.string';
import { ITradeOrderRepository } from 'src/core/repositories/trade-order.repository.abstract';
import { MongoGenericRepository } from './mongo-generic.repository';

@Injectable()
export class TradeOrderRepository extends MongoGenericRepository<ITradeOrder> implements ITradeOrderRepository {
  constructor(@Inject(InjectableEntities.TradeOrder) readonly tradeOrderEntity: Model<ITradeOrder>) {
    super(tradeOrderEntity);
  }

  async getMakerTakerOrders(ids: number[], pair: string): Promise<ITradeOrder[] | null> {
    const data = await this.tradeOrderEntity
      .find({ eng_order_id: { $in: ids }, pair: pair })
      .lean()
      .exec();

    if (!data || data.length === 0) return null;
    return data;
  }

  async getOrderByEngIdandUserId(engId: number, userId: string): Promise<ITradeOrder | null> {
    const data = await this.tradeOrderEntity
      .findOne({ eng_order_id: engId, user_id: new mongoose.Types.ObjectId(userId) })
      .lean()
      .exec();

    if (!data) return null;
    return data;
  }

  async getOrderByEngId(engId: number): Promise<ITradeOrder | null> {
    const data = await this.tradeOrderEntity.findOne({ eng_order_id: engId }).lean().exec();

    if (!data) return null;
    return data;
  }

  async updateStatusOfSellLimitOrder(pair: string, status: string, price: number): Promise<boolean> {
    const data = await this.tradeOrderEntity
      .updateMany(
        { pair: pair, order_type: 'Stop Limit', status: 'InActive', stop_price: { $gte: price } },
        { $set: { status: status } },
      )
      .exec();

    if (!data) return false;
    return true;
  }

  async updateStatusOfBuyLimitOrder(pair: string, status: string, price: number): Promise<boolean> {
    const data = await this.tradeOrderEntity
      .updateMany(
        { pair: pair, order_type: 'Stop Limit', status: 'InActive', stop_price: { $lte: price } },
        { $set: { status: status } },
      )
      .exec();

    if (!data) return false;
    return true;
  }

  async getActiveLimitOrder(pair: string): Promise<ITradeOrder[] | null> {
    const data = await this.tradeOrderEntity
      .find({
        pair: pair,
        order_type: 'Stop Limit',
        status: OrderStatus.active,
        eng_order_id: { $in: [-1, null] } /** only the limit orders that are not not sent to engine */,
      })
      .lean()
      .exec();

    if (!data || data.length === 0) return null;
    return data;
  }

  async getOrderByOrderIdAndUserId(orderId: number, userId: string): Promise<ITradeOrder | null> {
    const data = await this.tradeOrderEntity
      .findOne({ orderId: orderId, user_id: new mongoose.Types.ObjectId(userId) })
      .lean()
      .exec();
    if (!data) return null;
    return data;
  }
}
