import { Channels } from 'src/common/constants/channels.constants';
import { AppException } from '../exceptions/app.exception';

export class WebsocketChannelRoom {
  private constructor(readonly room: string) {}
  static createMarketChannel(type: keyof typeof Channels, symbol: string): WebsocketChannelRoom {
    if (!symbol || !type) {
      throw new AppException('Symbol and channel cannot be empty', 400);
    }

    if (!Channels.hasOwnProperty(type)) {
      throw new AppException(`Invalid channel type: ${type}`);
    }

    return new WebsocketChannelRoom(`${type}:${symbol}`.toLowerCase());
  }

  static createMarketChannelWithInterval(
    type: keyof typeof Channels,
    symbol: string,
    interval: string,
  ): WebsocketChannelRoom {
    if (!symbol || !type) {
      throw new AppException('Symbol and channel cannot be empty', 400);
    }

    return new WebsocketChannelRoom(`${type.toLowerCase()}:${symbol.toLowerCase()}:${interval}`);
  }

  static createUserChannel(type: keyof typeof Channels, userId: string): WebsocketChannelRoom {
    if (!userId || !type) {
      throw new AppException('User ID and channel cannot be empty', 400);
    }

    return new WebsocketChannelRoom(`${type.toLowerCase()}:${userId}`);
  }
}
