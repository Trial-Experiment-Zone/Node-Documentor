<file path="src/core/services/market-data/candle-scheduler.service.ts">
import { Injectable, OnModuleInit } from '@nestjs/common';
import { IKline } from '@onexchainorg/userpanel-schemas/dist/interfaces/kline.interface';
import { ICacheManager } from 'src/core/interfaces/cache-manager.interface';
import { LoggerService } from 'src/infrastructure/logger/logger.service';
import { KlinePersistenceService } from './kline-persistence.service';

@Injectable()
export class CandleSchedulerService implements OnModuleInit {
  private readonly CHECK_INTERVAL = 10000; // 10 seconds
  private readonly REDIS_KEY_PREFIX = 'ohlc:';
  private intervalId: NodeJS.Timeout;

  constructor(
    private readonly logger: LoggerService,
    private readonly cacheManager: ICacheManager,
    private readonly klinePersistenceService: KlinePersistenceService,
  ) {
    this.logger.setContext(CandleSchedulerService.name);
  }

  async onModuleInit() {
    this.startScheduler();
  }

  onModuleDestroy() {
    if (this.intervalId) {
      clearInterval(this.intervalId);
    }
  }

  private startScheduler() {
    this.intervalId = setInterval(() => {
      this.checkAndCloseCandles().catch((error) => {
        this.logger.error({
          event: 'SCHEDULER_ERROR',
          error,
          message: 'Error in candle scheduler',
        });
      });
    }, this.CHECK_INTERVAL);

    this.logger.log({
      event: 'SCHEDULER_STARTED',
      checkInterval: this.CHECK_INTERVAL,
      message: 'Candle scheduler started',
    });
  }

  private async checkAndCloseCandles(): Promise<void> {
    try {
      this.logger.log(`Checking and closing short-term candles Scheduler at ${new Date().toISOString()}`);
      const currentTimestamp = Date.now();
      let closedCount = 0;

      // Get all OHLC keys from Redis
      const keys = await this.cacheManager.keys(`${this.REDIS_KEY_PREFIX}*`);

      for (const key of keys) {
        const candle = await this.cacheManager.get<IKline>(key);
        if (candle && currentTimestamp >= candle.intervalEnd) {
          // Close the candle
          const updatedCandle = { ...candle, isClosed: true };

          // Remove from Redis since it's closed
          await this.cacheManager.del(key);

          // Save the final state to database
          await this.klinePersistenceService.handleKlineCreated(updatedCandle);

          closedCount++;
        }
      }

      if (closedCount > 0) {
        this.logger.log({
          event: 'CANDLES_CLOSED',
          count: closedCount,
          message: `Closed ${closedCount} expired candles and saved to database`,
        });
      }
    } catch (error) {
      this.logger.error({
        event: 'CANDLE_CLOSE_ERROR',
        error,
        message: 'Failed to close candles',
      });
    }
  }
}
</file>

<file path="src/core/services/market-data/kline-persistence.service.ts">
import { Injectable } from '@nestjs/common';
import { IKline } from '@onexchainorg/userpanel-schemas/dist/interfaces';
import { IntervalTypeEnum } from 'src/core/interfaces/ohlc-data.interface';
import { IKlineRepository } from 'src/core/repositories/kline.repository.abstract';
import { LoggerService } from 'src/infrastructure/logger/logger.service';

@Injectable()
export class KlinePersistenceService {
  constructor(
    private readonly klineRepository: IKlineRepository,
    private readonly logger: LoggerService,
  ) {
    this.logger.setContext(KlinePersistenceService.name);
  }

  async handleKlineCreated(kline: IKline) {
    try {
      await this.klineRepository.createOrUpdateKline(kline);
      this.logger.debug({
        event: 'KLINE_SAVED',
        symbol: kline.symbol,
        interval: kline.interval,
        intervalStart: kline.intervalStart,
        message: 'New kline saved to database',
      });

      // If this is a 15m kline, update all in-progress long-term candles
      if (kline.interval === IntervalTypeEnum.fifteenMinutes) {
        await Promise.all([
          this.updateInProgressKline(IntervalTypeEnum.fourHours, kline.symbol, kline),
          this.updateInProgressKline(IntervalTypeEnum.oneDay, kline.symbol, kline),
          this.updateInProgressKline(IntervalTypeEnum.oneWeek, kline.symbol, kline),
          this.updateInProgressKline(IntervalTypeEnum.oneMonth, kline.symbol, kline),
        ]);

        this.logger.debug({
          event: 'LONG_TERM_KLINES_UPDATED',
          symbol: kline.symbol,
          sourceInterval: kline.interval,
          message: 'Updated all in-progress long-term candles from 15m kline',
        });
      }
    } catch (error) {
      this.logger.error({
        event: 'KLINE_SAVE_ERROR',
        error,
        symbol: kline.symbol,
        interval: kline.interval,
        intervalStart: kline.intervalStart,
        message: 'Failed to save new kline to database',
      });
    }
  }

  async handleKlineUpdated(kline: IKline) {
    try {
      await this.klineRepository.createOrUpdateKline(kline);
      this.logger.debug({
        event: 'KLINE_UPDATED',
        symbol: kline.symbol,
        interval: kline.interval,
        intervalStart: kline.intervalStart,
        message: 'Kline updated in database',
      });
    } catch (error) {
      this.logger.error({
        event: 'KLINE_UPDATE_ERROR',
        error,
        symbol: kline.symbol,
        interval: kline.interval,
        intervalStart: kline.intervalStart,
        message: 'Failed to update kline in database',
      });
    }
  }

  async handleKlineClosed(kline: IKline) {
    try {
      await this.klineRepository.createOrUpdateKline({
        ...kline,
        symbol: kline.symbol.replace('_', '/'),
        isClosed: true,
      });
      this.logger.debug({
        event: 'KLINE_CLOSED',
        symbol: kline.symbol,
        interval: kline.interval,
        intervalStart: kline.intervalStart,
        message: 'Kline marked as closed in database',
      });
    } catch (error) {
      this.logger.error({
        event: 'KLINE_CLOSE_ERROR',
        error,
        symbol: kline.symbol,
        interval: kline.interval,
        intervalStart: kline.intervalStart,
        message: 'Failed to mark kline as closed in database',
      });
    }
  }

  /**
   * Updates or creates an in-progress kline for the specified interval and symbol.
   * If an in-progress kline exists, it updates the OHLC and volume data.
   * If no in-progress kline exists, it creates a new one.
   *
   * @param interval The interval for the kline
   * @param symbol The trading pair symbol
   * @param kline The new kline data to update or create with
   */
  async updateInProgressKline(
    interval:
      | IntervalTypeEnum.fourHours
      | IntervalTypeEnum.oneDay
      | IntervalTypeEnum.oneWeek
      | IntervalTypeEnum.oneMonth,
    symbol: string,
    kline: IKline,
  ) {
    try {
      const normalizedSymbol = symbol.includes('_') ? symbol : symbol.replace('/', '_');

      // Find existing in-progress kline for this interval and symbol
      const existingKline = await this.klineRepository.findKline(normalizedSymbol, interval, kline.intervalStart);

      let updatedKline: IKline;

      if (existingKline && !existingKline.isClosed) {
        // Update existing in-progress kline by recalculating OHLC and volume
        updatedKline = {
          ...existingKline,
          high: Math.max(existingKline.high, kline.high),
          low: Math.min(existingKline.low, kline.low),
          close: kline.close,
          volume: existingKline.volume + kline.volume,
          trades: (existingKline.trades || 0) + (kline.trades || 0),
          vwap:
            (existingKline.volume * existingKline.vwap + kline.volume * kline.close) /
            (existingKline.volume + kline.volume),
          isClosed: false,
        };

        this.logger.debug({
          event: 'IN_PROGRESS_KLINE_UPDATING',
          symbol: normalizedSymbol,
          interval,
          intervalStart: kline.intervalStart,
          message: 'Updating existing in-progress kline',
        });
      } else {
        // Create new in-progress kline
        updatedKline = {
          ...kline,
          symbol: normalizedSymbol,
          interval,
          isClosed: false,
        };

        this.logger.debug({
          event: 'IN_PROGRESS_KLINE_CREATING',
          symbol: normalizedSymbol,
          interval,
          intervalStart: kline.intervalStart,
          message: 'Creating new in-progress kline',
        });
      }

      await this.klineRepository.createOrUpdateKline(updatedKline);

      this.logger.debug({
        event: 'IN_PROGRESS_KLINE_UPDATED',
        symbol: normalizedSymbol,
        interval,
        intervalStart: kline.intervalStart,
        message: 'In-progress kline operation completed',
      });
    } catch (error) {
      this.logger.error({
        event: 'IN_PROGRESS_KLINE_UPDATE_ERROR',
        error,
        symbol,
        interval,
        intervalStart: kline.intervalStart,
        message: 'Failed to update in-progress kline',
      });
      throw error;
    }
  }
}
</file>

