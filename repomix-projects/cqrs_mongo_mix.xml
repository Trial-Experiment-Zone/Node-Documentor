<file path="src/main.ts">
import { ValidationPipe } from '@nestjs/common';
import { NestFactory } from '@nestjs/core';
import { AppModule } from './app.module';
import { formatValidationErrors } from './common/error-formatter/validation-error-reducer';
import { AppException } from './core/exceptions/app.exception';
import { LoggerService } from './infrastructure/logger/logger.service';
import { AllExceptionsFilter } from './presentation/filters/all-exceptions.filter';
import { CustomWebSocketAdapter } from './presentation/modules/websocket/websocket.adapter';

async function bootstrap() {
  const app = await NestFactory.create(AppModule, {
    cors: true,
    logger: ['error', 'warn', 'log', 'debug'],
  });
  app.setGlobalPrefix('api');

  // Use custom WebSocket adapter
  const webSocketAdapter = new CustomWebSocketAdapter(app);
  app.useWebSocketAdapter(webSocketAdapter);

  // Enable CORS with options that match WebSocket needs
  app.enableCors({
    origin: '*',
    methods: ['GET', 'POST', 'PUT', 'DELETE', 'PATCH', 'OPTIONS'],
    credentials: true,
    allowedHeaders: ['authorization', 'x-api-key', 'content-type'],
  });

  // Global validation pipe
  app.useGlobalPipes(
    new ValidationPipe({
      transform: true,
      exceptionFactory: (errors) => {
        const validationRes = formatValidationErrors(errors);
        return new AppException(validationRes.message, 400, validationRes.error);
      },
    }),
  );

  // Global exception filter
  const exceptionLogger = await app.resolve(LoggerService);
  app.useGlobalFilters(new AllExceptionsFilter(exceptionLogger));

  const port = process.env.PORT ?? 3000;
  await app.listen(port);
  console.log(`Application running on port ${port}`);
}
bootstrap().catch((err) => {
  console.error('Error starting the application:', err);
  process.exit(1);
});
</file>

