<file path="src/common/utils/get-start-end-date-by-interval.ts">
export function getStartEndDateByInterval(interval: string): { start: number; end: number } {
  const data: { start: number; end: number } = { start: 0, end: 0 };

  const currentIntervalStart = Date.now();

  switch (interval) {
    case '1m':
      data.start = currentIntervalStart - 60 * 1000;
      data.end = currentIntervalStart;
      break;
    case '5m':
      data.start = currentIntervalStart - 5 * 60 * 1000;
      data.end = currentIntervalStart;
      break;
    case '15m':
      data.start = currentIntervalStart - 15 * 60 * 1000;
      data.end = currentIntervalStart;
      break;
    case '30m':
      data.start = currentIntervalStart - 30 * 60 * 1000;
      data.end = currentIntervalStart;
      break;
    case '1h':
      data.start = currentIntervalStart - 60 * 60 * 1000;
      data.end = currentIntervalStart;
      break;
    case '4h':
      data.start = currentIntervalStart - 4 * 60 * 60 * 1000;
      data.end = currentIntervalStart;
      break;
    case '1w':
      data.start = currentIntervalStart - 7 * 24 * 60 * 60 * 1000;
      data.end = currentIntervalStart;
      break;
    case '1M':
      data.start = currentIntervalStart - 30 * 24 * 60 * 60 * 1000;
      data.end = currentIntervalStart;
      break;
    case '1d':
      data.start = currentIntervalStart - 24 * 60 * 60 * 1000;
      data.end = currentIntervalStart;
      break;
    default:
      throw new Error('Invalid interval');
  }
  return data;
}
</file>

