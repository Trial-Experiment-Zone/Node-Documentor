import { IQueryHandler, QueryHandler } from '@nestjs/cqrs';
import { IKline } from '@onexchainorg/userpanel-schemas/interfaces';
import { KlineResponse } from 'src/common/interface/kline.response';
import { IUseCaseResponse } from 'src/common/interface/response/interface/response.result.interface';
import { AppException } from 'src/core/exceptions/app.exception';
import { ICacheManager } from 'src/core/interfaces/cache-manager.interface';
import { IKlineRepository } from 'src/core/repositories/kline.repository.abstract';
import { GetKlinesQueryDto } from 'src/presentation/dtos/market-data/get-klines-query';

export class GetKlineQuery {
  constructor(public readonly queryData: GetKlinesQueryDto) {
    if (!queryData.symbol) {
      throw new AppException('Symbol cannot be empty', 400);
    }
    if (!queryData.interval) {
      throw new AppException('Interval cannot be empty', 400);
    }
  }
}

@QueryHandler(GetKlineQuery)
export class GetKlineQueryHandler implements IQueryHandler<GetKlineQuery, IUseCaseResponse<any>> {
  constructor(
    private readonly klineRepository: IKlineRepository,
    private readonly cacheManager: ICacheManager,
  ) {}

  async execute(query: GetKlineQuery): Promise<any> {
    const { symbol, interval, from, to } = query.queryData;

    const data = await this.klineRepository.findBySymbolAndIntervalAndTime(
      symbol.replace('_', '/'),
      interval,
      +from,
      +to,
    );

    /**
     * check if interval lies in short term or long term
     * if short term, then get the ohlc from the cache, combine the data with the data from the database and return the data
     */
    const shortTermIntervals = ['1m', '5m', '15m', '30m', '1h'];

    if (shortTermIntervals.includes(interval) && +to >= Date.now()) {
      /**
       * there will only be one in progress kline for a symbol and interval
       */
      const redisKeyPattern = `ohlc:${symbol}:${interval}:*`.toLowerCase();
      const keys = await this.cacheManager.keys(redisKeyPattern);
      if (keys.length) {
        const cachedData = await this.cacheManager.get<IKline>(keys[0]);
        if (cachedData) {
          data.push(cachedData);
        }
      }
    }

    return { data: data.map(KlineResponse.toResponse), success: true, message: 'Klines fetched successfully' };
  }
}
</file>

