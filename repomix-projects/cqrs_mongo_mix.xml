<file path="src/infrastructure/data-sources/mongo/repo-helpers/get-kline-data.ts">
export async function getKlineDataHelper(transactionHistoryEntity, queryData, dateQuery, limit = 1000) {
  return await transactionHistoryEntity.aggregate([
    {
      $match: {
        pair: queryData.pair,
        created_date: {
          $gte: new Date(parseInt(queryData.from)),
          $lte: new Date(parseInt(queryData.to)),
        },
      },
    },
    {
      $sort: { created_date: 1 },
    },
    {
      $group: {
        _id: {
          year: {
            $year: '$created_date',
          },
          ...dateQuery,
        },
        open: { $first: '$created_date' }, // timestamp
        first: { $first: '$price' }, // open price
        max: { $max: '$price' }, // high price
        min: { $min: '$price' }, // low price
        last: { $last: '$price' }, // close price
        sum: { $sum: '$total' }, // volume
        close: { $last: '$created_date' }, // end date
        n: { $sum: '$total' },
      },
    },
    {
      $project: {
        _id: 0,
        open: 1,
        first: 1,
        max: 1,
        min: 1,
        last: 1,
        sum: 1,
        close: 1,
        n: 1,
      },
    },
    { $sort: { open: 1 } },
    {
      $project: {
        data: {
          $objectToArray: '$$ROOT',
        },
      },
    },
    {
      $group: {
        _id: null,
        data: {
          $push: '$data.v',
        },
      },
    },
    {
      $project: {
        data: 1,
      },
    },
    {
      $limit: limit,
    },
  ]);
}
</file>

