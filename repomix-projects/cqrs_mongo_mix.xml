<file path="src/infrastructure/messaging/nats/nats.service.ts">
// nats.service.ts
import { Injectable, OnModuleDestroy, OnModuleInit } from '@nestjs/common';
import { connect, NatsConnection, StringCodec, Subscription } from 'nats';
import { LoggerService } from 'src/infrastructure/logger/logger.service';

type MessageHandler = (data: any, raw: Uint8Array) => void;

@Injectable()
export class NatsService implements OnModuleInit, OnModuleDestroy {
  private nc!: NatsConnection;
  private sc = StringCodec();
  private handlers = new Map<string, MessageHandler>();

  constructor(private readonly logger: LoggerService) {
    this.logger.setContext(NatsService.name);
  }
  public get connection(): NatsConnection {
    return this.nc;
  }

  async onModuleInit() {
    this.nc = await connect({ servers: [process.env.NATS_URI] });
    this.logger.log('NATS connected');

    for (const [subject, handler] of this.handlers.entries()) {
      this.subscribe(subject, handler);
    }
  }

  async onModuleDestroy() {
    await this.nc.drain();
    this.logger.log('👋 NATS connection closed');
  }

  public async publish(subject: string, data: any) {
    const encoded = this.sc.encode(JSON.stringify(data));
    this.nc.publish(subject, encoded);
    this.logger.log(`Published to [${subject}]: ${JSON.stringify(data)}`);
  }

  public on(subject: string, handler: MessageHandler) {
    this.handlers.set(subject, handler);
    if (this.nc) {
      this.subscribe(subject, handler);
    }
  }

  private async subscribe(subject: string, handler: MessageHandler) {
    const sub: Subscription = this.nc.subscribe(subject);
    this.logger.log(`Subscribed to [${subject}]`);

    for await (const msg of sub) {
      const decoded = this.sc.decode(msg.data);
      try {
        const parsed = JSON.parse(decoded);
        handler(parsed, msg.data);
      } catch (err) {
        this.logger.error(`Failed to parse message on [${subject}]`, err);
      }
    }
  }

  public async send(subject: string, data: any) {
    const encoded = this.sc.encode(JSON.stringify(data));
    const response = await this.nc.request(subject, encoded);
    const decoded = this.sc.decode(response.data);
    try {
      return JSON.parse(decoded);
    } catch (err) {
      this.logger.error(`Failed to parse message on [${subject}]`, err);
    }
  }
}
</file>

