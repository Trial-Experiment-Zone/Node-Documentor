<file path="src/common/error-formatter/validation-error-reducer.ts">
import { ValidationError } from '@nestjs/common';

export function formatValidationErrors(errors: ValidationError[]) {
  function extractErrors(validationErrors: ValidationError[]): Record<string, string> {
    return validationErrors.reduce(
      (acc, err) => {
        if (err.constraints) {
          // Join all constraint messages for the field
          acc[err.property] = Object.values(err.constraints).join(', ');
        }

        // Recursively process children if they exist
        if (err.children && err.children.length > 0) {
          const childErrors = extractErrors(err.children);
          Object.entries(childErrors).forEach(([key, value]) => {
            acc[`${err.property}.${key}`] = value; // Include parent property in the key
          });
        }

        return acc;
      },
      {} as Record<string, string>,
    );
  }

  const errorDetails = extractErrors(errors);

  return {
    message: 'validation failed',
    error: errorDetails,
  };
}
</file>

