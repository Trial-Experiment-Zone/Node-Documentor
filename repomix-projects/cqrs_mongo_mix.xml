import { Inject, Injectable } from '@nestjs/common';
import { ITradeTransactionHistory } from '@onexchainorg/userpanel-schemas/interfaces';
import { Model } from 'mongoose';
import { InjectableEntities } from 'src/application/commands/injectable.string';
import { getStartEndDateByInterval } from 'src/common/utils/get-start-end-date-by-interval';
import { ITradeTransactionHistoryRepository } from 'src/core/repositories/trade-transation-history.repository.abstract';
import { createDateFilter } from '../repo-helpers/create-date-filter';
import { getKlineDataHelper } from '../repo-helpers/get-kline-data';
import { MongoGenericRepository } from './mongo-generic.repository';

@Injectable()
export class TradeTransactionHistoryRepository
  extends MongoGenericRepository<ITradeTransactionHistory>
  implements ITradeTransactionHistoryRepository
{
  constructor(
    @Inject(InjectableEntities.TradeTransactionHistoryEntity)
    readonly tradeTransactionHistory: Model<ITradeTransactionHistory>,
  ) {
    super(tradeTransactionHistory);
  }

  async getKlineData(
    pair: string,
    interval: string,
    fromDate: string,
    toDate: string,
    limit: number = 1000,
  ): Promise<any[] | null> {
    let chartData: any;
    if (interval === '1W' || interval === '1w') {
      interval = '7d';
    } else if (interval === '1M') {
      interval = '30d';
    } else if (interval.includes('D') || interval.includes('d')) {
      if (pair === 'OXO/USDT') {
        return [];
      } else {
        interval = interval.toLowerCase();
      }
    } else if (interval.includes('H') || interval.includes('h')) {
      if (pair === 'OXO/USDT' && interval === '1h') {
        return [];
      } else if (pair === 'OXO/USDT' && interval === '4h') {
        return [];
      } else {
        interval = interval.toLowerCase();
      }
    } else {
      if (pair === 'OXO/USDT' && interval === '1m') {
        chartData = [];
      }
      interval = interval + 'm';
    }
    const { dateQuery } = createDateFilter({
      duration: interval,
      fromDate,
      toDate,
    });
    const result = await getKlineDataHelper(
      this.tradeTransactionHistory,
      {
        pair,
        from: fromDate,
        to: toDate,
      },
      dateQuery,
      limit,
    );
    if (!chartData) chartData = []; //: ME;
    if (result[0] && result[0]['data']) chartData = result[0]['data'];
    return chartData;
  }

  async bulkCreateTradeTransactionHistory(data: ITradeTransactionHistory[]): Promise<boolean> {
    try {
      await this.tradeTransactionHistory.insertMany(data);
      return true;
    } catch (err) {
      console.error('Error inserting trade transaction history:', err);
      return false;
    }
  }

  async getRecentTrades(): Promise<ITradeTransactionHistory[] | null> {
    try {
      const trades = await this.tradeTransactionHistory.find().sort({ created_date: -1 }).limit(500).exec();
      return trades;
    } catch (error) {
      console.error('Error fetching recent trades:', error);
      return null;
    }
  }

  async getKlineOfInterval(pair: string, interval: string): Promise<any | null> {
    const dateStartEnd = getStartEndDateByInterval(interval);

    const splittedPair = pair.split('/');
    const socPair = `${splittedPair[0]}_${splittedPair[1]}`;

    const result = await this.tradeTransactionHistory.aggregate([
      {
        $match: {
          pair: pair,
          created_date: {
            $gte: new Date(dateStartEnd.start),
            $lt: new Date(dateStartEnd.end),
          },
        },
      },
      {
        $group: {
          _id: '$pair',
          h: { $max: '$price' },
          l: { $min: '$price' },
          q: { $sum: '$total' },
          o: { $first: '$price' },
          c: { $last: '$price' },
          n: { $sum: 1 },
          t: { $first: '$created_date' },
          T: { $last: '$created_date' },
        },
      },
      {
        $addFields: {
          t: {
            $toLong: '$t',
          },
          T: {
            $toLong: '$T',
          },
        },
      },
      {
        $project: {
          _id: 0,
          h: 1,
          l: 1,
          q: 1,
          o: 1,
          c: 1,
          n: 1,
          i: interval,
          s: socPair,
          t: 1,
          T: 1,
          B: '0',
        },
      },
    ]);
    const klineData = {
      e: 'kline',
      E: +new Date(),
      s: socPair,
      k: result[0],
    };
    return klineData;
  }
}
</file>

<file path="src/infrastructure/messaging/event-relay/event-relay.service.ts">
import { Injectable, OnModuleInit } from '@nestjs/common';
import { AggBuySellTrade, NatsTopics } from '@onexchainorg/shared/matching-engine';
import { Channels } from 'src/common/constants/channels.constants';
import { INatsMessage } from 'src/core/interfaces/nats-message.interface';
import { IWebSocketMessage } from 'src/core/interfaces/websocket-message.interface';
import { OHLCService } from 'src/core/services/market-data/ohlc.service';
import { RecentTradesService } from 'src/core/services/market-data/recent-trades.service';
import { Ticker24hService } from 'src/core/services/market-data/ticker-24h.service';
import { TradeQueueService } from 'src/core/services/market-data/trade-queue.service';
import { WebsocketChannelRoom } from 'src/core/value-ojects/websocket-channel.vo';
import { LoggerService } from 'src/infrastructure/logger/logger.service';
import { WebSocketService } from 'src/presentation/modules/websocket/services/websocket.service';
import { NatsService } from '../nats/nats.service';

@Injectable()
export class EventRelayService implements OnModuleInit {
  constructor(
    private readonly natsService: NatsService,
    private readonly websocketService: WebSocketService,
    private readonly logger: LoggerService,
    private readonly ohlcService: OHLCService,
    private readonly recentTradesService: RecentTradesService,
    private readonly ticker24hService: Ticker24hService,
    private readonly tradeQueueService: TradeQueueService,
  ) {
    this.logger.setContext(EventRelayService.name);
  }

  private formatMessage<T>(natsMessage: INatsMessage<T>): IWebSocketMessage<T> {
    return {
      channel: natsMessage.event,
      data: natsMessage.data,
    };
  }

  async onModuleInit() {
    this.natsService.on(NatsTopics.market_price_update, (natsMessage: INatsMessage<any>) => {
      this.logger.log(`Relaying NATS event [market_price_update]: ${JSON.stringify(natsMessage)}`);
      const channelRoom = WebsocketChannelRoom.createMarketChannel(Channels.ticker, natsMessage.pair);
      const message = this.formatMessage(natsMessage);
      this.websocketService.broadcastMarketDataEvent(channelRoom.room, message);
    });

    this.natsService.on(NatsTopics.depth_update, (natsMessage: INatsMessage<any>) => {
      const channelRoom = WebsocketChannelRoom.createMarketChannel(Channels.book, natsMessage.pair);
      this.logger.log(`Relaying NATS event [depth_update]: ${JSON.stringify(natsMessage)}`);
      const message = this.formatMessage(natsMessage);
      this.websocketService.broadcastMarketDataEvent(channelRoom.room, message);
    });

    this.natsService.on(NatsTopics.trade_executed, async (natsMessage: INatsMessage<AggBuySellTrade>) => {
      const channelRoom = WebsocketChannelRoom.createMarketChannel(Channels.trade, natsMessage.pair);
      this.logger.log(`Relaying NATS event [trade_executed]: ${JSON.stringify(natsMessage)}`);
      const message = this.formatMessage(natsMessage);
      this.websocketService.broadcastMarketDataEvent(channelRoom.room, message);

      // Add trade to recent trades
      await this.recentTradesService.addTrade(natsMessage.data);

      // Update 24h ticker and broadcast update
      await this.ticker24hService.updateTicker(natsMessage.data);

      // Queue the trade for OHLC processing
      await this.tradeQueueService.addTrade(natsMessage.data);
    });

    this.natsService.on('order_executed', (natsMessage: INatsMessage<any>) => {
      this.logger.log(`Relaying NATS event [order_executed]: ${JSON.stringify(natsMessage)}`);
      // Uncomment and implement if needed:
      // const message = this.formatMessage(natsMessage);
      // this.websocketService.broadcast('order_executed', message);
    });

    this.natsService.on(NatsTopics.balance_update, async (natsMessage: INatsMessage<any>) => {
      this.logger.log(`Relaying NATS event [balance_update]: ${JSON.stringify(natsMessage)}`);
      const message = this.formatMessage(natsMessage);
      this.websocketService.emitBalanceUpdate(message);
    });

    this.natsService.on(NatsTopics.order_update, (natsMessage: INatsMessage<any>) => {
      this.logger.log(`Relaying NATS event [order_update]: ${JSON.stringify(natsMessage)}`);
      const message = this.formatMessage(natsMessage);
      this.websocketService.emitExecution(message);
    });
  }
}
</file>

