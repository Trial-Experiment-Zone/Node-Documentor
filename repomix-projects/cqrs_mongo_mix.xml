import { Injectable, OnModuleInit } from '@nestjs/common';
import { AggBuySellTrade } from '@onexchainorg/shared/matching-engine';
import { IKline } from '@onexchainorg/userpanel-schemas/dist/interfaces/kline.interface';
import { Channels } from 'src/common/constants/channels.constants';
import { KlineResponse } from 'src/common/interface/kline.response';
import { ICacheManager } from 'src/core/interfaces/cache-manager.interface';
import { IntervalType, IntervalTypeEnum } from 'src/core/interfaces/ohlc-data.interface';
import { WebsocketChannelRoom } from 'src/core/value-ojects/websocket-channel.vo';
import { LoggerService } from 'src/infrastructure/logger/logger.service';
import { WebSocketService } from 'src/presentation/modules/websocket/services/websocket.service';

@Injectable()
export class OHLCService implements OnModuleInit {
  private readonly REDIS_KEY_PREFIX = 'ohlc:';

  /**
   * generating only short term candles for now
   */
  private intervals: IntervalType[] = [
    IntervalTypeEnum.oneSecond,
    IntervalTypeEnum.oneMinute,
    IntervalTypeEnum.fiveMinutes,
    IntervalTypeEnum.fifteenMinutes,
    IntervalTypeEnum.oneHour,
  ];
  private readonly MAX_RETRIES = 5;

  constructor(
    private readonly logger: LoggerService,
    private readonly websocketService: WebSocketService,
    private readonly cacheManager: ICacheManager,
  ) {
    this.logger.setContext(OHLCService.name);
  }

  async onModuleInit() {
    // No need to load from Redis as we'll create new candles as trades come in
  }

  private isValidInterval(interval: string): boolean {
    return this.intervals.includes(interval as IntervalType);
  }

  private getRedisKey(symbol: string, interval: IntervalType, startTime: number): string {
    return `${this.REDIS_KEY_PREFIX}${symbol.toLowerCase()}:${interval}:${startTime}`;
  }

  private async saveCandle(candle: IKline, trade: AggBuySellTrade, retryCount = 0): Promise<void> {
    const key = this.getRedisKey(candle.symbol, candle.interval as IntervalType, candle.intervalStart);
    try {
      if (!this.isValidInterval(candle.interval)) {
        return;
      }

      this.logger.debug({
        event: 'SAVING_CANDLE',
        tradeId: trade.tradeId,
        redisKey: key,
        volume: candle.volume,
        trades: candle.trades,
        retryCount,
      });

      /**
       * watch the key to avoid race condition
       * if the key is being updated by another process, we will wait for it to finish
       */
      await this.cacheManager.watch(key);
      const currentCandle = await this.cacheManager.get<IKline>(key);

      this.logger.debug({
        event: 'CURRENT_CANDLE',
        tradeId: trade.tradeId,
        redisKey: key,
        currentCandle,
        retryCount,
      });

      if (currentCandle) {
        // If there's an existing candle, merge the updates
        const totalVolume = currentCandle.volume + candle.volume;
        const totalValue = currentCandle.vwap * currentCandle.volume + trade.price * candle.volume;

        this.logger.debug({
          event: 'MERGING_CANDLES',
          tradeId: trade.tradeId,
          currentVolume: currentCandle.volume,
          newVolume: candle.volume,
          totalVolume,
          currentTrades: currentCandle.trades,
          retryCount,
        });

        candle = {
          ...currentCandle,
          high: Math.max(currentCandle.high, candle.high),
          low: Math.min(currentCandle.low, candle.low),
          close: candle.close,
          trades: currentCandle.trades + 1, // Increment by 1 for this trade
          volume: totalVolume, // Add the new volume to existing
          vwap: totalValue / totalVolume,
        };
      }

      // await this.cacheManager.set(key, candle);

      const multi = this.cacheManager.multi();
      await multi.set(key, candle);
      const success = await multi.exec();

      this.logger.debug({
        event: 'TRANSACTION_RESULT',
        tradeId: trade.tradeId,
        redisKey: key,
        success,
        finalVolume: candle.volume,
        finalTrades: candle.trades,
        retryCount,
      });

      if (!success && retryCount < this.MAX_RETRIES) {
        // If transaction failed, retry after a small delay
        await new Promise((resolve) => setTimeout(resolve, 10)); // Add small delay before retry
        return this.saveCandle(candle, trade, retryCount + 1);
      }

      if (success) {
        this.logger.debug({
          event: 'CANDLE_SAVED_TO_REDIS',
          tradeId: trade.tradeId,
          symbol: candle.symbol,
          interval: candle.interval,
          intervalStart: candle.intervalStart,
          retryCount,
          volume: candle.volume,
          trades: candle.trades,
          message: `Saved active OHLC candle to Redis`,
        });
      }
    } catch (error) {
      this.logger.error({
        event: 'SAVE_CANDLE_ERROR',
        tradeId: trade.tradeId,
        error,
        retryCount,
        redisKey: key,
      });

      if (retryCount < this.MAX_RETRIES) {
        // If error occurred, retry after a small delay
        await new Promise((resolve) => setTimeout(resolve, 10)); // Add small delay before retry
        return this.saveCandle(candle, trade, retryCount + 1);
      }

      this.logger.error({
        event: 'REDIS_SAVE_ERROR',
        symbol: candle.symbol,
        interval: candle.interval,
        error,
        retryCount,
        message: 'Failed to save candle to Redis after retries',
      });
    } finally {
      await this.cacheManager.unwatch();
    }
  }

  private getIntervalStartFromUTC12(timestamp: number, interval: IntervalType): number {
    const date = new Date(timestamp);
    const utc12Today = new Date(Date.UTC(date.getUTCFullYear(), date.getUTCMonth(), date.getUTCDate(), 12, 0, 0, 0));
    const utc12Timestamp = utc12Today.getTime();
    const intervalMs = this.getIntervalMilliseconds(interval);

    if (timestamp < utc12Timestamp) {
      // If current time is before UTC 12:00, use previous day's UTC 12:00
      const prevDay = new Date(utc12Timestamp);
      prevDay.setUTCDate(prevDay.getUTCDate() - 1);
      const minutesSincePrevUTC12 = Math.floor((timestamp - prevDay.getTime()) / intervalMs);
      return prevDay.getTime() + minutesSincePrevUTC12 * intervalMs;
    }

    // If current time is after or equal to UTC 12:00, use today's UTC 12:00
    const minutesSinceUTC12 = Math.floor((timestamp - utc12Timestamp) / intervalMs);
    return utc12Timestamp + minutesSinceUTC12 * intervalMs;
  }

  private getIntervalMilliseconds(interval: IntervalType): number {
    const units: { [key: string]: number } = {
      s: 1000, // 1 second in milliseconds
      m: 60 * 1000, // 1 minute in milliseconds
      h: 60 * 60 * 1000, // 1 hour in milliseconds
      d: 24 * 60 * 60 * 1000, // 1 day in milliseconds
      w: 7 * 24 * 60 * 60 * 1000, // 1 week in milliseconds
      M: 30 * 24 * 60 * 60 * 1000, // Approximate month in milliseconds
    };

    const value = parseInt(interval);
    const unit = interval.slice(-1);
    return value * units[unit];
  }

  private initializeCandle(symbol: string, interval: IntervalType, trade: AggBuySellTrade): IKline {
    const intervalStart = this.getIntervalStartFromUTC12(trade.timestamp, interval);
    const intervalMs = this.getIntervalMilliseconds(interval);

    return {
      symbol,
      open: trade.price,
      high: trade.price,
      low: trade.price,
      close: trade.price,
      trades: 1,
      volume: trade.quantity,
      vwap: trade.price,
      intervalStart,
      intervalEnd: intervalStart + intervalMs,
      isClosed: false,
      interval,
    };
  }

  private updateCandle(candle: IKline, trade: AggBuySellTrade): IKline {
    const newVolume = trade.quantity;
    return {
      ...candle,
      high: Math.max(candle.high, trade.price),
      low: Math.min(candle.low, trade.price),
      close: trade.price,
      trades: 1, // We'll add this to existing trades in saveCandle
      volume: newVolume, // We'll add this to existing volume in saveCandle
      vwap: trade.price, // We'll recalculate VWAP in saveCandle
    };
  }

  async processTrade(trade: AggBuySellTrade): Promise<void> {
    // Process the trade for each interval
    for (const interval of this.intervals) {
      const intervalStart = this.getIntervalStartFromUTC12(trade.timestamp, interval);
      const key = this.getRedisKey(trade.symbol, interval, intervalStart);
      let candle = await this.cacheManager.get<IKline>(key);

      if (!candle) {
        // Create new candle
        candle = this.initializeCandle(trade.symbol, interval, trade);
        this.logger.debug({
          event: 'NEW_CANDLE_CREATED',
          tradeId: trade.tradeId,
          redisKey: key,
          candle,
        });
      } else {
        // Update existing candle
        candle = this.updateCandle(candle, trade);
        this.logger.debug({
          event: 'CANDLE_UPDATED',
          tradeId: trade.tradeId,
          redisKey: key,
          candle,
        });
      }

      // Save to Redis with optimistic locking
      await this.saveCandle(candle, trade);

      // Emit to WebSocket clients
      const channelRoom = WebsocketChannelRoom.createMarketChannelWithInterval(Channels.ohlc, trade.symbol, interval);
      this.websocketService.broadcastMarketDataEvent(channelRoom.room, {
        channel: Channels.ohlc,
        data: KlineResponse.toResponse(candle),
      });
    }
  }

  async getCandles(_symbol: string, _interval: IntervalType, _limit: number = 500): Promise<IKline[]> {
    // TODO: get candles from database
    return [];
  }

  async getCandle(symbol: string, interval: IntervalType, timestamp: number): Promise<IKline | undefined> {
    const intervalStart = this.getIntervalStartFromUTC12(timestamp, interval);
    const key = this.getRedisKey(symbol, interval, intervalStart);
    return this.cacheManager.get<IKline>(key);
  }
}
</file>

<file path="src/core/strategies/create-order/create-limit-order.strategy.ts">
import { Injectable } from '@nestjs/common';
import { NatsTopics, OrderSide } from '@onexchainorg/shared/matching-engine';
import { ITradeOrder, IWallet } from '@onexchainorg/userpanel-schemas/interfaces';
import { Channels } from 'src/common/constants/channels.constants';
import { IUseCaseResponse } from 'src/common/interface/response/interface/response.result.interface';
import { ICreateOrderStrategy } from 'src/core/interfaces/create-order.interface';
import { ICreateOrderInput } from 'src/core/interfaces/place-order.interface';
import { ITradeOrderRepository } from 'src/core/repositories/trade-order.repository.abstract';
import { TradeBalanceService } from 'src/core/services/trade/trade-balance.service';
import { TradeOrderFactoryService } from 'src/core/services/trade/trade-order.factory.service';
import { NatsService } from 'src/infrastructure/messaging/nats/nats.service';
import { IApiRequestPayload } from 'src/presentation/dtos/api-key/api-key.response';

@Injectable()
export class CreateLimitOrderStrategy implements ICreateOrderStrategy {
  constructor(
    private readonly tradeBalanceService: TradeBalanceService,
    private readonly tradeOrderRepository: ITradeOrderRepository,
    private readonly tradeOrderFactoryService: TradeOrderFactoryService,
    private readonly natsService: NatsService,
  ) {}
  async execute(
    orderDto: ICreateOrderInput,
    loginPaylod: IApiRequestPayload,
  ): Promise<IUseCaseResponse<ITradeOrder | null>> {
    let currency = ''; // default currency is first part of symbol assuming it is buy

    /**
     * get currency from symbol
     */
    if (orderDto.side === OrderSide.sell) {
      currency = orderDto.symbol.split('_')[0];
    } else if (orderDto.side === OrderSide.buy) {
      currency = orderDto.symbol.split('_')[1];
    }

    if (!currency) return { success: false, message: 'Invalid currency', data: null };

    const orderAmtRes = await this.tradeBalanceService.calculateOrderAmount(
      orderDto.side,
      orderDto.price,
      orderDto.quantity,
    );

    if (!orderAmtRes.success) return { success: false, message: orderAmtRes.message, data: null };
    /**
     * calculate the amount of currency to be deducted from the user wallet
     */

    const balanceRes = await this.tradeBalanceService.checkUserBalance(loginPaylod.userId, currency, orderAmtRes.data);

    if (!balanceRes || !balanceRes.success) {
      balanceRes.data = null;
      return { success: false, message: balanceRes.message, data: null };
    }

    const lockRes: IUseCaseResponse<IWallet> = await this.tradeBalanceService.lockUserBalance(
      loginPaylod.userId,
      currency,
      orderAmtRes.data,
    );
    if (!lockRes || !lockRes.success) return { success: false, message: lockRes.message, data: null };

    const wallet = lockRes.data.wallet.find((w) => w.currency_code === currency);
    await this.natsService.publish(NatsTopics.balance_update, {
      data: {
        userId: loginPaylod.userId,
        balance: { currency: currency, amount: wallet.Amount, inorder: wallet.inorder },
      },
      event: Channels.balances,
      pair: orderDto.symbol,
    });
    orderDto.userId = loginPaylod.userId;
    orderDto.initialAmount = orderDto.quantity;
    orderDto.price = orderDto.price;
    const order = await this.tradeOrderRepository.createOne(this.tradeOrderFactoryService.createTradeOrder(orderDto));

    if (!order) return { success: false, message: 'Failed to create order', data: null };
    return { success: true, message: 'Order created successfully', data: order };
  }
}
