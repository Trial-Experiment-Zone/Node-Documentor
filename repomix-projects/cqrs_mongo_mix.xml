<file path="src/core/strategies/create-order/create-market-order.strategy.ts">
import { Injectable } from '@nestjs/common';
import { MatchingEngineOrderResponse, NatsResponse, NatsTopics, OrderSide } from '@onexchainorg/shared/matching-engine';
import { ITradeOrder } from '@onexchainorg/userpanel-schemas/interfaces';
import { Channels } from 'src/common/constants/channels.constants';
import { IUseCaseResponse } from 'src/common/interface/response/interface/response.result.interface';
import { generateNewId } from 'src/common/utils/id-generator';
import { ICreateOrderStrategy } from 'src/core/interfaces/create-order.interface';
import { ICreateOrderInput } from 'src/core/interfaces/place-order.interface';
import { ITradeOrderRepository } from 'src/core/repositories/trade-order.repository.abstract';
import { TradeBalanceService } from 'src/core/services/trade/trade-balance.service';
import { TradeOrderFactoryService } from 'src/core/services/trade/trade-order.factory.service';
import { NatsService } from 'src/infrastructure/messaging/nats/nats.service';
import { IApiRequestPayload } from 'src/presentation/dtos/api-key/api-key.response';

@Injectable()
export class CreateMarketOrderStrategy implements ICreateOrderStrategy {
  constructor(
    private readonly tradeBalanceService: TradeBalanceService,
    private readonly tradeOrderRepository: ITradeOrderRepository,
    private readonly tradeOrderFactoryService: TradeOrderFactoryService,
    private readonly natsService: NatsService,
  ) {}
  async execute(
    orderDto: ICreateOrderInput,
    loginPaylod: IApiRequestPayload,
  ): Promise<IUseCaseResponse<ITradeOrder | null>> {
    try {
      let currency = ''; // default currency is first part of symbol assuming it is buy

      /**
       * get currency from symbol
       */
      if (orderDto.side === OrderSide.sell) {
        currency = orderDto.symbol.split('_')[0];
      } else if (orderDto.side === OrderSide.buy) {
        currency = orderDto.symbol.split('_')[1];
      }

      if (!currency) return { success: false, message: 'Invalid currency', data: null };

      /**
       * calculate the locked amount of currency to be deducted for market order.
       */
      let amountToBeLocked = 0;
      if (OrderSide.sell === orderDto.side) {
        const natsSimRes: NatsResponse<MatchingEngineOrderResponse> = await this.natsService.send('simulate_order', {
          symbol: orderDto.symbol,
          side: orderDto.side,
          type: orderDto.type,
          quantity: orderDto.quantity,
          exOrderId: generateNewId(),
        });

        if (!natsSimRes.success)
          return { success: false, message: natsSimRes.msg || (natsSimRes as any).msg, data: null };
        /**
         * get simulated trades price
         */
        natsSimRes.data.trades.forEach((trade) => {
          if (trade.side === orderDto.side) amountToBeLocked += trade.price * trade.quantity;
        });
      } else {
        amountToBeLocked = orderDto.quantity;
      }

      /**
       * calculate the amount of currency to be deducted from the user wallet
       */

      const balanceRes = await this.tradeBalanceService.checkUserBalance(
        loginPaylod.userId,
        currency,
        amountToBeLocked,
      );

      if (!balanceRes || !balanceRes.success) {
        balanceRes.data = null;
        return { success: false, message: balanceRes.message, data: null };
      }

      const lockRes = await this.tradeBalanceService.lockUserBalance(loginPaylod.userId, currency, amountToBeLocked);
      if (!lockRes || !lockRes.success) return { success: false, message: lockRes.message, data: null };

      const wallet = lockRes.data.wallet.find((w) => w.currency_code === currency);
      await this.natsService.publish(NatsTopics.balance_update, {
        data: {
          userId: loginPaylod.userId,
          balance: { currency: currency, amount: wallet.Amount, inorder: wallet.inorder },
        },
        event: Channels.balances,
        pair: orderDto.symbol,
      });
      orderDto.userId = loginPaylod.userId;
      orderDto.initialAmount = orderDto.quantity;
      orderDto.price = orderDto.price;
      const order = await this.tradeOrderRepository.createOne(this.tradeOrderFactoryService.createTradeOrder(orderDto));

      if (!order) return { success: false, message: 'Failed to create order', data: null };
      return { success: true, message: 'Order created successfully', data: order };
    } catch (err) {
      return { success: false, message: 'Failed to create order', data: null, errors: err as any };
    }
  }
}
</file>

<file path="src/infrastructure/data-sources/mongo/repositories/kline.repository.ts">
import { Inject, Injectable } from '@nestjs/common';
import { IKline } from '@onexchainorg/userpanel-schemas/dist/interfaces';
import { Model } from 'mongoose';
import { InjectableEntities } from 'src/application/commands/injectable.string';
import { IKlineRepository } from 'src/core/repositories/kline.repository.abstract';
import { MongoGenericRepository } from './mongo-generic.repository';

@Injectable()
export class MongoKlineRepository extends MongoGenericRepository<IKline> implements IKlineRepository {
  constructor(@Inject(InjectableEntities.KlineEntity) readonly klineEntity: Model<IKline>) {
    super(klineEntity);
  }

  async findBySymbolAndInterval(symbol: string, interval: string, limit?: number): Promise<IKline[]> {
    const query = this.klineEntity.find({ symbol, interval }).sort({ intervalStart: -1 });

    if (limit) {
      query.limit(limit);
    }

    return query.exec();
  }

  async findBySymbolAndIntervalAndTime(
    symbol: string,
    interval: string,
    startTime: number,
    endTime: number,
  ): Promise<IKline[]> {
    return this.klineEntity
      .find({
        symbol,
        interval,
        intervalStart: { $gte: startTime },
        intervalEnd: { $lte: endTime },
      })
      .sort({ intervalStart: -1 })
      .exec();
  }

  async createOrUpdateKline(kline: IKline): Promise<IKline> {
    const filter = {
      symbol: kline.symbol,
      interval: kline.interval,
      intervalStart: kline.intervalStart,
    };

    const existingKline = await this.klineEntity.findOne(filter).exec();
    if (existingKline) {
      return this.klineEntity.findOneAndUpdate(filter, kline, { new: true }).exec();
    }
    return this.klineEntity.create(kline);
  }

  async findKline(symbol: string, interval: string, intervalStart: number): Promise<IKline | null> {
    return this.klineEntity
      .findOne({
        symbol,
        interval,
        intervalStart,
      })
      .exec();
  }

  async aggregateKline(symbol: string, interval: string, startTime: number, endTime: number): Promise<IKline> {
    const result = await this.klineEntity.aggregate([
      {
        $match: {
          symbol,
          interval,
          intervalStart: { $gte: startTime },
          intervalEnd: { $lte: endTime },
        },
      },
      {
        $sort: { intervalStart: 1 },
      },
      {
        $group: {
          _id: null,
          open: { $first: '$open' },
          high: { $max: '$high' },
          low: { $min: '$low' },
          close: { $last: '$close' },
          volume: { $sum: '$volume' },
          trades: { $sum: '$trades' },
          // Calculate VWAP: Σ(price * volume) / Σ(volume)
          totalVolumePrice: { $sum: { $multiply: ['$vwap', '$volume'] } },
          firstIntervalStart: { $first: '$intervalStart' },
          lastIntervalEnd: { $last: '$intervalEnd' },
        },
      },
      {
        $project: {
          symbol: { $literal: symbol },
          interval: { $literal: interval },
          open: 1,
          high: 1,
          low: 1,
          close: 1,
          volume: 1,
          trades: 1,
          vwap: { $divide: ['$totalVolumePrice', '$volume'] },
          intervalStart: '$firstIntervalStart',
          intervalEnd: '$lastIntervalEnd',
          isClosed: { $literal: false },
        },
      },
    ]);

    if (!result.length) {
      return null;
    }

    return result[0];
  }
}
</file>

