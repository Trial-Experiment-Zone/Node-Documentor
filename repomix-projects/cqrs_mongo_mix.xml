import { Order, OrderSide, OrderStatus, OrderType, Trade } from '@onexchainorg/shared/matching-engine';
import { ITradeOrder } from '@onexchainorg/userpanel-schemas/interfaces';
import { TradeResponse } from './trade-response';

export class OrderResponse {
  orderId: number; /**It is the exchange order Id */
  type: OrderType;
  symbol: string;
  side: OrderSide;
  price: number;
  quantity: number;
  leaveQuantity: number;
  status: OrderStatus;
  timestamp: number;
  trades?: TradeResponse[];

  static toResponse(order: Order): OrderResponse {
    return {
      orderId: order.exOrderId,
      type: order.type,
      symbol: order.symbol,
      side: order.side,
      price: order.price,
      quantity: order.quantity,
      leaveQuantity: order.leaveQuantity,
      status: order.status,
      timestamp: order.timestamp,
    };
  }

  static dbOrderToResponse(order: ITradeOrder) {
    return {
      orderId: order.orderId,
      type: order.order_type,
      symbol: order.pair.replace('/', '_'),
      side: order.trade_type,
      price: order.market_price,
      stopPrice: order.stop_price,
      quantity: order.ordered_amount,
      leaveQuantity: order.ordered_amount,
      status: order.status,
      timestamp: order.ordered_date,
    };
  }
}

export class OrderCreateResponse {
  order: OrderResponse;
  trades: TradeResponse[];
}

export class LimitOrderTriggerResponse {
  order: Order;
  trades: Trade[];
}
