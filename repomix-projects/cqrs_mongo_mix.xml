<file path="src/infrastructure/data-sources/mongo/repo-helpers/create-date-filter.ts">
export function createDateFilter(data) {
  try {
    const { duration } = data;
    let dateQuery, secondQuery, concatQuery, sortQuery;
    const interval = +duration.match(/\d+/g).join('');

    if (duration.includes('d')) {
      dateQuery = {
        month: { $month: '$created_date' },
        interval: {
          $subtract: [{ $dayOfMonth: '$created_date' }, { $mod: [{ $dayOfMonth: '$created_date' }, interval] }],
        },
      };
      secondQuery = {
        interval: '$_id.interval',
        month: '$_id.month',
      };
      concatQuery = {
        $concat: [{ $toString: '$_id.interval' }, '/', { $toString: '$_id.month' }, '/', { $toString: '$_id.year' }],
      };
      sortQuery = { '_id.year': 1, '_id.month': 1, '_id.interval': 1 };
    } else if (duration.includes('h')) {
      dateQuery = {
        month: { $month: '$created_date' },
        dayOfMonth: { $dayOfMonth: '$created_date' },
        interval: {
          $subtract: [{ $hour: '$created_date' }, { $mod: [{ $hour: '$created_date' }, interval] }],
        },
      };
      secondQuery = {
        dayOfMonth: '$_id.dayOfMonth',
        interval: '$_id.interval',
        month: '$_id.month',
      };
      concatQuery = {
        $concat: [
          { $toString: '$_id.dayOfMonth' },
          '/',
          { $toString: '$_id.month' },
          '/',
          { $toString: '$_id.year' },
          ' - ',
          { $toString: '$_id.interval' },
          ':00',
        ],
      };
      sortQuery = { '_id.year': 1, '_id.month': 1, '_id.dayOfMonth': 1, '_id.interval': 1 };
    } else if (duration.includes('m')) {
      dateQuery = {
        month: { $month: '$created_date' },
        dayOfMonth: { $dayOfMonth: '$created_date' },
        hour: { $hour: '$created_date' },
        interval: {
          $subtract: [{ $minute: '$created_date' }, { $mod: [{ $minute: '$created_date' }, interval] }],
        },
      };
      secondQuery = {
        month: '$_id.month',
        hour: '$_id.hour',
        dayOfMonth: '$_id.dayOfMonth',
        interval: '$_id.interval',
      };

      concatQuery = {
        $concat: [
          { $toString: '$_id.dayOfMonth' },
          '/',
          { $toString: '$_id.month' },
          '/',
          { $toString: '$_id.year' },
          ' - ',
          { $toString: '$_id.hour' },
          ':',
          { $toString: '$_id.interval' },
        ],
      };
      sortQuery = { '_id.year': 1, '_id.month': 1, '_id.dayOfMonth': 1, '_id.hour': 1, '_id.interval': 1 };
    } else if (duration.includes('s')) {
      dateQuery = {
        month: { $month: '$created_date' },
        dayOfMonth: { $dayOfMonth: '$created_date' },
        hour: { $hour: '$created_date' },
        interval: {
          $subtract: [{ $second: '$created_date' }, { $mod: [{ $second: '$created_date' }, interval] }],
        },
      };
      secondQuery = {
        month: '$_id.month',
        hour: '$_id.hour',
        dayOfMonth: '$_id.dayOfMonth',
        interval: '$_id.interval',
      };

      concatQuery = {
        $concat: [
          { $toString: '$_id.dayOfMonth' },
          '/',
          { $toString: '$_id.month' },
          '/',
          { $toString: '$_id.year' },
          ' - ',
          { $toString: '$_id.hour' },
          ':',
          { $toString: '$_id.interval' },
        ],
      };
      sortQuery = { '_id.year': 1, '_id.month': 1, '_id.dayOfMonth': 1, '_id.hour': 1, '_id.interval': 1 };
    }

    return { error: false, dateQuery, secondQuery, concatQuery, sortQuery };
  } catch (err) {
    console.log(err);
    return { error: true };
  }
}
