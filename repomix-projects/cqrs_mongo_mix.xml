import { IQueryHandler, QueryHandler } from '@nestjs/cqrs';
import { IUseCaseResponse } from 'src/common/interface/response/interface/response.result.interface';
import { AppException } from 'src/core/exceptions/app.exception';
import { ITradePairRepository } from 'src/core/repositories/trade-pair.repository.abstract';

export class PriceTickerQuery {
  constructor(public readonly symbols: string[]) {
    if (!symbols || symbols.length === 0) {
      throw new AppException('Symbols array cannot be empty', 400);
    }
  }
}

@QueryHandler(PriceTickerQuery)
export class PriceTickerQueryHandler
  implements IQueryHandler<PriceTickerQuery, IUseCaseResponse<{ symbol: string; price: number }[]>>
{
  constructor(private readonly tradePairRepository: ITradePairRepository) {}

  async execute(query: PriceTickerQuery): Promise<IUseCaseResponse<{ symbol: string; price: number }[]>> {
    const { symbols } = query;
    const tradePairs = await this.tradePairRepository.getTradePairsBySymbols(symbols.map((s) => s.replace('_', '/')));
    const resData = tradePairs.map((pair) => ({
      symbol: pair.pair.toString().replace('/', '_'),
      price: pair.last_price ? parseFloat(pair.last_price.toString()) : 0,
    }));
    // const natsResponse = await this.natsService.send('get_price_tickers', { symbols });

    // if (!natsResponse.success) {
    //   throw new AppException(
    //     natsResponse.message || 'Failed to fetch price ticker data',
    //     natsResponse.statusCode || 400,
    //   );
    // }

    return {
      success: true,
      message: 'Price ticker data fetched successfully',
      data: resData,
    };
  }
}
