import { Injectable } from '@nestjs/common';
import { CommandHandler, ICommand, ICommandHandler } from '@nestjs/cqrs';
import {
  MatchingEngineCancelOrderResponse,
  NatsResponse,
  OrderSide,
  OrderStatus,
} from '@onexchainorg/shared/matching-engine';
import { OrderResponse } from 'src/common/interface/order-response';
import { IUseCaseResponse } from 'src/common/interface/response/interface/response.result.interface';
import { AppException } from 'src/core/exceptions/app.exception';
import { ITradeOrderRepository } from 'src/core/repositories/trade-order.repository.abstract';
import { TradeBalanceService } from 'src/core/services/trade/trade-balance.service';
import { LoggerService } from 'src/infrastructure/logger/logger.service';
import { NatsService } from 'src/infrastructure/messaging/nats/nats.service';
import { IApiRequestPayload } from 'src/presentation/dtos/api-key/api-key.response';

export class CancelOrderCommand implements ICommand {
  constructor(
    public readonly orderId: number,
    public readonly loginPaylod: IApiRequestPayload,
  ) {
    if (!orderId) {
      throw new AppException('Order ID cannot be empty', 400);
    }
  }
}

@Injectable()
@CommandHandler(CancelOrderCommand)
export class CancelOrderCommandHandler implements ICommandHandler<CancelOrderCommand, IUseCaseResponse<any>> {
  constructor(
    private readonly logger: LoggerService,
    private readonly natsService: NatsService,
    private readonly tradeOrderRepository: ITradeOrderRepository,
    private readonly tradeBalanceService: TradeBalanceService,
  ) {
    this.logger.setContext(CancelOrderCommandHandler.name);
  }

  async execute(command: CancelOrderCommand): Promise<IUseCaseResponse<any>> {
    const { orderId } = command;
    const loginPaylod: IApiRequestPayload = command.loginPaylod;

    // Fetch the order details
    const order = await this.tradeOrderRepository.getOrderByOrderIdAndUserId(orderId, loginPaylod.userId.toString());
    if (!order) {
      throw new AppException('Order not found', 404);
    }

    // Send cancel request to the matching engine
    const cancelRes: NatsResponse<MatchingEngineCancelOrderResponse> = await this.natsService.send('cancel_order', {
      orderId: order.eng_order_id,
    });
    if (!cancelRes || !cancelRes.success) {
      throw new AppException(cancelRes?.msg || 'Failed to cancel order', cancelRes?.statusCode || 400);
    }

    // Update order status to canceled
    const updateOrderRes = await this.tradeOrderRepository.updateById(order._id as string, {
      status: OrderStatus.cancelled,
      cancelled_date: new Date(),
    });
    if (!updateOrderRes) {
      throw new AppException('Failed to update order status', 400);
    }

    const engOrder = cancelRes.data.order;

    /**
     * update locked balance
     * if order is not filled
     */
    let amountToBeRefunded = 0;
    let currency = '';
    if (engOrder.leaveQuantity > 0) {
      if (engOrder.side === OrderSide.buy) {
        currency = engOrder.symbol.split('_')[1];
        amountToBeRefunded = engOrder.leaveQuantity * engOrder.price;
      } else {
        currency = engOrder.symbol.split('_')[0];
        amountToBeRefunded = engOrder.leaveQuantity;
      }
    }

    // Refund user balance if necessary
    const refundRes = await this.tradeBalanceService.refundLockedBalance(
      order.user_id.toString(),
      currency,
      amountToBeRefunded,
    );
    if (!refundRes.success) {
      throw new AppException(refundRes.message, 400);
    }

    /**
     * update orderId before sending to nats
     */
    this.logger.log(`Order ${orderId} canceled successfully ${engOrder.symbol}`);
    this.natsService.publish('order_cancelled', {
      event: 'order_cancelled',
      pair: engOrder.symbol,
      data: { order: OrderResponse.toResponse(engOrder), userId: order.user_id },
    });
    return {
      data: OrderResponse.toResponse(engOrder),
      success: true,
      message: 'Order canceled successfully',
    };
  }
}
</file>

