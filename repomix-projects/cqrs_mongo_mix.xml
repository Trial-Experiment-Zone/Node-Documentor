<file path="src/core/services/market-data/long-term-candle-generator.service.ts">
import { Injectable, Logger } from '@nestjs/common';
import { IKline } from '@onexchainorg/userpanel-schemas/dist/interfaces/kline.interface';
import { IntervalTypeEnum } from 'src/core/interfaces/ohlc-data.interface';
import { IKlineRepository } from 'src/core/repositories/kline.repository.abstract';

@Injectable()
export class LongTermCandleGeneratorService {
  private readonly logger = new Logger(LongTermCandleGeneratorService.name);
  private readonly FOUR_HOURS = 4 * 60 * 60 * 1000; // 4 hours in milliseconds
  private readonly ONE_DAY = 24 * 60 * 60 * 1000; // 1 day in milliseconds
  private readonly ONE_WEEK = 7 * 24 * 60 * 60 * 1000; // 1 week in milliseconds
  private readonly BATCH_SIZE = 10;

  constructor(private readonly klineRepository: IKlineRepository) {}

  async generate4HourCandle(symbol: string): Promise<void> {
    try {
      this.logger.debug(`Generating 4h candles for symbol: ${symbol}`);
      const lastCandles = await this.klineRepository.findBySymbolAndInterval(symbol, IntervalTypeEnum.fourHours, 1);

      const now = new Date();
      let startTime: number;

      if (lastCandles && lastCandles.length > 0) {
        startTime = lastCandles[0].intervalEnd;
      } else {
        const utc12Today = new Date(Date.UTC(now.getUTCFullYear(), now.getUTCMonth(), now.getUTCDate(), 12, 0, 0, 0));
        if (now.getTime() < utc12Today.getTime()) {
          utc12Today.setUTCDate(utc12Today.getUTCDate() - 1);
        }
        startTime = utc12Today.getTime();
      }

      const currentTime = now.getTime();
      // Calculate last complete interval
      const lastCompleteInterval = Math.floor(currentTime / this.FOUR_HOURS) * this.FOUR_HOURS;
      const numberOfCandles = Math.floor((lastCompleteInterval - startTime) / this.FOUR_HOURS);

      if (numberOfCandles <= 0) {
        this.logger.debug('No new complete 4h candles to generate');
      }

      this.logger.debug(`Generating ${numberOfCandles} complete 4h candles from ${new Date(startTime).toISOString()}`);

      const batches = Math.ceil(numberOfCandles / this.BATCH_SIZE);

      // Handle complete candles in batches
      for (let batchIndex = 0; batchIndex < batches; batchIndex++) {
        const batchCandles: IKline[] = [];
        const batchStart = batchIndex * this.BATCH_SIZE;
        const batchEnd = Math.min((batchIndex + 1) * this.BATCH_SIZE, numberOfCandles);

        for (let i = batchStart; i < batchEnd; i++) {
          const candleStartTime = startTime + i * this.FOUR_HOURS;
          const candleEndTime = candleStartTime + this.FOUR_HOURS;

          const aggregatedCandle = await this.klineRepository.aggregateKline(
            symbol,
            IntervalTypeEnum.fiveMinutes,
            candleStartTime,
            candleEndTime,
          );

          if (aggregatedCandle && aggregatedCandle.volume > 0) {
            aggregatedCandle.interval = IntervalTypeEnum.fourHours;
            aggregatedCandle.isClosed = true;
            batchCandles.push(aggregatedCandle);
          }
        }

        if (batchCandles.length > 0) {
          await this.klineRepository.createMany(batchCandles);

          this.logger.debug({
            event: 'BATCH_SAVED',
            batchIndex,
            candlesCount: batchCandles.length,
            symbol,
            interval: IntervalTypeEnum.fourHours,
          });
        }
      }

      // Handle current ongoing interval
      const currentIntervalStart = lastCompleteInterval;

      const currentCandle = await this.klineRepository.aggregateKline(
        symbol,
        IntervalTypeEnum.fiveMinutes,
        currentIntervalStart,
        currentTime,
      );

      if (currentCandle && currentCandle.volume > 0) {
        currentCandle.interval = IntervalTypeEnum.fourHours;
        currentCandle.isClosed = false;
        await this.klineRepository.createOrUpdateKline(currentCandle);

        this.logger.debug({
          event: 'CURRENT_CANDLE_UPDATED',
          symbol,
          interval: IntervalTypeEnum.fourHours,
          startTime: new Date(currentIntervalStart).toISOString(),
          currentTime: new Date(currentTime).toISOString(),
        });
      }

      this.logger.debug({
        event: 'FOUR_HOUR_CANDLES_GENERATED',
        symbol,
        numberOfCandles,
        startTime: new Date(startTime).toISOString(),
        endTime: new Date(currentTime).toISOString(),
      });
    } catch (error) {
      this.logger.error({
        event: 'FOUR_HOUR_CANDLE_GENERATION_ERROR',
        error,
        symbol,
        message: 'Failed to generate 4h candles',
      });
      throw error;
    }
  }

  async generate1DayCandle(symbol: string): Promise<void> {
    try {
      this.logger.debug(`Generating 1d candles for symbol: ${symbol}`);
      const lastCandles = await this.klineRepository.findBySymbolAndInterval(symbol, IntervalTypeEnum.oneDay, 1);

      const now = new Date();
      let startTime: number;

      if (lastCandles && lastCandles.length > 0) {
        startTime = lastCandles[0].intervalEnd;
      } else {
        const utc0Today = new Date(Date.UTC(now.getUTCFullYear(), now.getUTCMonth(), now.getUTCDate(), 0, 0, 0, 0));
        if (now.getTime() < utc0Today.getTime()) {
          utc0Today.setUTCDate(utc0Today.getUTCDate() - 1);
        }
        startTime = utc0Today.getTime();
      }

      const currentTime = now.getTime();
      // Calculate last complete interval
      const lastCompleteInterval = Math.floor(currentTime / this.ONE_DAY) * this.ONE_DAY;
      const numberOfCandles = Math.floor((lastCompleteInterval - startTime) / this.ONE_DAY);

      if (numberOfCandles <= 0) {
        this.logger.debug('No new complete 1d candles to generate');
      }

      this.logger.debug(`Generating ${numberOfCandles} complete 1d candles from ${new Date(startTime).toISOString()}`);

      const batches = Math.ceil(numberOfCandles / this.BATCH_SIZE);

      // Handle complete candles in batches
      for (let batchIndex = 0; batchIndex < batches; batchIndex++) {
        const batchCandles: IKline[] = [];
        const batchStart = batchIndex * this.BATCH_SIZE;
        const batchEnd = Math.min((batchIndex + 1) * this.BATCH_SIZE, numberOfCandles);

        for (let i = batchStart; i < batchEnd; i++) {
          const candleStartTime = startTime + i * this.ONE_DAY;
          const candleEndTime = candleStartTime + this.ONE_DAY;

          const aggregatedCandle = await this.klineRepository.aggregateKline(
            symbol,
            IntervalTypeEnum.oneHour,
            candleStartTime,
            candleEndTime,
          );

          if (aggregatedCandle && aggregatedCandle.volume > 0) {
            aggregatedCandle.interval = IntervalTypeEnum.oneDay;
            aggregatedCandle.isClosed = true;
            batchCandles.push(aggregatedCandle);
          }
        }

        if (batchCandles.length > 0) {
          await this.klineRepository.createMany(batchCandles);

          this.logger.debug({
            event: 'BATCH_SAVED',
            batchIndex,
            candlesCount: batchCandles.length,
            symbol,
            interval: IntervalTypeEnum.oneDay,
          });
        }
      }

      // Handle current ongoing interval
      const currentIntervalStart = lastCompleteInterval;

      const currentCandle = await this.klineRepository.aggregateKline(
        symbol,
        IntervalTypeEnum.oneHour,
        currentIntervalStart,
        currentTime,
      );

      if (currentCandle && currentCandle.volume > 0) {
        currentCandle.interval = IntervalTypeEnum.oneDay;
        currentCandle.isClosed = false;
        await this.klineRepository.createOrUpdateKline(currentCandle);

        this.logger.debug({
          event: 'CURRENT_CANDLE_UPDATED',
          symbol,
          interval: IntervalTypeEnum.oneDay,
          startTime: new Date(currentIntervalStart).toISOString(),
          currentTime: new Date(currentTime).toISOString(),
        });
      }

      this.logger.debug({
        event: 'ONE_DAY_CANDLES_GENERATED',
        symbol,
        numberOfCandles,
        startTime: new Date(startTime).toISOString(),
        endTime: new Date(currentTime).toISOString(),
      });
    } catch (error) {
      this.logger.error({
        event: 'ONE_DAY_CANDLE_GENERATION_ERROR',
        error,
        symbol,
        message: 'Failed to generate 1d candles',
      });
      throw error;
    }
  }

  async generate1WeekCandle(symbol: string): Promise<void> {
    try {
      this.logger.debug(`Generating 1w candles for symbol: ${symbol}`);
      const lastCandles = await this.klineRepository.findBySymbolAndInterval(symbol, IntervalTypeEnum.oneWeek, 1);

      const now = new Date();
      let startTime: number;

      if (lastCandles && lastCandles.length > 0) {
        startTime = lastCandles[0].intervalEnd;
      } else {
        // Start from Monday 00:00 UTC
        const currentDay = now.getUTCDay(); // 0 = Sunday, 1 = Monday, ..., 6 = Saturday
        const daysToMonday = currentDay === 0 ? 6 : currentDay - 1;
        const monday = new Date(
          Date.UTC(now.getUTCFullYear(), now.getUTCMonth(), now.getUTCDate() - daysToMonday, 0, 0, 0, 0),
        );
        startTime = monday.getTime();
      }

      const currentTime = now.getTime();
      // Calculate last complete interval
      const lastCompleteInterval = Math.floor(currentTime / this.ONE_WEEK) * this.ONE_WEEK;
      const numberOfCandles = Math.floor((lastCompleteInterval - startTime) / this.ONE_WEEK);

      if (numberOfCandles <= 0) {
        this.logger.debug('No new complete 1w candles to generate');
      }

      this.logger.debug(`Generating ${numberOfCandles} complete 1w candles from ${new Date(startTime).toISOString()}`);

      const batches = Math.ceil(numberOfCandles / this.BATCH_SIZE);

      // Handle complete candles in batches
      for (let batchIndex = 0; batchIndex < batches; batchIndex++) {
        const batchCandles: IKline[] = [];
        const batchStart = batchIndex * this.BATCH_SIZE;
        const batchEnd = Math.min((batchIndex + 1) * this.BATCH_SIZE, numberOfCandles);

        for (let i = batchStart; i < batchEnd; i++) {
          const candleStartTime = startTime + i * this.ONE_WEEK;
          const candleEndTime = candleStartTime + this.ONE_WEEK;

          const aggregatedCandle = await this.klineRepository.aggregateKline(
            symbol,
            IntervalTypeEnum.oneHour,
            candleStartTime,
            candleEndTime,
          );

          if (aggregatedCandle && aggregatedCandle.volume > 0) {
            aggregatedCandle.interval = IntervalTypeEnum.oneWeek;
            aggregatedCandle.isClosed = true;
            batchCandles.push(aggregatedCandle);
          }
        }

        if (batchCandles.length > 0) {
          await this.klineRepository.createMany(batchCandles);

          this.logger.debug({
            event: 'BATCH_SAVED',
            batchIndex,
            candlesCount: batchCandles.length,
            symbol,
            interval: IntervalTypeEnum.oneWeek,
          });
        }
      }

      // Handle current ongoing interval
      const currentIntervalStart = lastCompleteInterval;

      const currentCandle = await this.klineRepository.aggregateKline(
        symbol,
        IntervalTypeEnum.oneHour,
        currentIntervalStart,
        currentTime,
      );

      if (currentCandle && currentCandle.volume > 0) {
        currentCandle.interval = IntervalTypeEnum.oneWeek;
        currentCandle.isClosed = false;
        await this.klineRepository.createOrUpdateKline(currentCandle);

        this.logger.debug({
          event: 'CURRENT_CANDLE_UPDATED',
          symbol,
          interval: IntervalTypeEnum.oneWeek,
          startTime: new Date(currentIntervalStart).toISOString(),
          currentTime: new Date(currentTime).toISOString(),
        });
      }

      this.logger.debug({
        event: 'ONE_WEEK_CANDLES_GENERATED',
        symbol,
        numberOfCandles,
        startTime: new Date(startTime).toISOString(),
        endTime: new Date(currentTime).toISOString(),
      });
    } catch (error) {
      this.logger.error({
        event: 'ONE_WEEK_CANDLE_GENERATION_ERROR',
        error,
        symbol,
        message: 'Failed to generate 1w candles',
      });
      throw error;
    }
  }

  async generate1MonthCandle(symbol: string): Promise<void> {
    try {
      this.logger.debug(`Generating 1M candles for symbol: ${symbol}`);
      const lastCandles = await this.klineRepository.findBySymbolAndInterval(symbol, IntervalTypeEnum.oneMonth, 1);

      const now = new Date();
      let startTime: number;

      if (lastCandles && lastCandles.length > 0) {
        startTime = lastCandles[0].intervalEnd;
      } else {
        // Start from first day of current month at 00:00 UTC
        startTime = Date.UTC(now.getUTCFullYear(), now.getUTCMonth(), 1, 0, 0, 0, 0);
      }

      const currentTime = now.getTime();
      // For monthly candles, we need to handle variable month lengths
      const currentMonth = now.getUTCMonth();
      const currentYear = now.getUTCFullYear();
      const lastCompleteMonth =
        currentMonth === 0
          ? Date.UTC(currentYear - 1, 11, 1, 0, 0, 0, 0) // December of previous year
          : Date.UTC(currentYear, currentMonth - 1, 1, 0, 0, 0, 0); // Previous month

      // Calculate number of months between start time and last complete month
      const startDate = new Date(startTime);
      const lastCompleteDate = new Date(lastCompleteMonth);
      const monthsDiff =
        (lastCompleteDate.getUTCFullYear() - startDate.getUTCFullYear()) * 12 +
        (lastCompleteDate.getUTCMonth() - startDate.getUTCMonth());
      const numberOfCandles = Math.max(0, monthsDiff);

      if (numberOfCandles <= 0) {
        this.logger.debug('No new complete 1M candles to generate');
      }

      this.logger.debug(`Generating ${numberOfCandles} complete 1M candles from ${new Date(startTime).toISOString()}`);

      const batches = Math.ceil(numberOfCandles / this.BATCH_SIZE);

      // Handle complete candles in batches
      for (let batchIndex = 0; batchIndex < batches; batchIndex++) {
        const batchCandles: IKline[] = [];
        const batchStart = batchIndex * this.BATCH_SIZE;
        const batchEnd = Math.min((batchIndex + 1) * this.BATCH_SIZE, numberOfCandles);

        for (let i = batchStart; i < batchEnd; i++) {
          const candleStartDate = new Date(startTime);
          candleStartDate.setUTCMonth(candleStartDate.getUTCMonth() + i);
          const candleStartTime = candleStartDate.getTime();

          const candleEndDate = new Date(candleStartTime);
          candleEndDate.setUTCMonth(candleEndDate.getUTCMonth() + 1);
          const candleEndTime = candleEndDate.getTime();

          const aggregatedCandle = await this.klineRepository.aggregateKline(
            symbol,
            IntervalTypeEnum.oneHour,
            candleStartTime,
            candleEndTime,
          );

          if (aggregatedCandle && aggregatedCandle.volume > 0) {
            aggregatedCandle.interval = IntervalTypeEnum.oneMonth;
            aggregatedCandle.isClosed = true;
            batchCandles.push(aggregatedCandle);
          }
        }

        if (batchCandles.length > 0) {
          await this.klineRepository.createMany(batchCandles);

          this.logger.debug({
            event: 'BATCH_SAVED',
            batchIndex,
            candlesCount: batchCandles.length,
            symbol,
            interval: IntervalTypeEnum.oneMonth,
          });
        }
      }

      // Handle current ongoing interval
      const currentMonthStart = Date.UTC(currentYear, currentMonth, 1, 0, 0, 0, 0);

      const currentCandle = await this.klineRepository.aggregateKline(
        symbol,
        IntervalTypeEnum.oneHour,
        currentMonthStart,
        currentTime,
      );

      if (currentCandle && currentCandle.volume > 0) {
        currentCandle.interval = IntervalTypeEnum.oneMonth;
        currentCandle.isClosed = false;
        await this.klineRepository.createOrUpdateKline(currentCandle);

        this.logger.debug({
          event: 'CURRENT_CANDLE_UPDATED',
          symbol,
          interval: IntervalTypeEnum.oneMonth,
          startTime: new Date(currentMonthStart).toISOString(),
          currentTime: new Date(currentTime).toISOString(),
        });
      }

      this.logger.debug({
        event: 'ONE_MONTH_CANDLES_GENERATED',
        symbol,
        numberOfCandles,
        startTime: new Date(startTime).toISOString(),
        endTime: new Date(currentTime).toISOString(),
      });
    } catch (error) {
      this.logger.error({
        event: 'ONE_MONTH_CANDLE_GENERATION_ERROR',
        error,
        symbol,
        message: 'Failed to generate 1M candles',
      });
      throw error;
    }
  }
}
