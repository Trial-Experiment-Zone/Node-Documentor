    order.market_price = orderDto.price;
    order.order_type = orderDto.type;
    order.trade_type = orderDto.side;
    order.pair = orderDto.symbol.replace('_', '/');
    order.to_currency = orderDto.symbol.split('_')[1];
    order.from_currency = orderDto.symbol.split('_')[0];
    order.user_id = orderDto.userId;
    order.orderId = generateNewId();
    order.total = orderDto.price * orderDto.quantity;
