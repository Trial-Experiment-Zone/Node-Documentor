  }

  async onModuleInit(): Promise<void> {
    await this.loadTickersFromRedis();
  }

  private getRedisKey(symbol: string): string {
    return `${this.REDIS_KEY_PREFIX}${symbol.toLowerCase()}`;
  }

  private async loadTickersFromRedis(): Promise<void> {
    try {
      const keys = await this.cacheManager.keys(`${this.REDIS_KEY_PREFIX}*`);
      for (const key of keys) {
        const symbol = key.replace(this.REDIS_KEY_PREFIX, '');
        const ticker = await this.cacheManager.get<ITicker24h>(key);
        if (ticker) {
          this.tickerMap.set(symbol, ticker);
          this.logger.debug({
            event: 'TICKER_LOADED_FROM_REDIS',
            symbol,
            ticker,
            message: `Loaded 24h ticker from Redis for ${symbol}`,
          });
        }
      }
    } catch (error) {
      this.logger.error({
        event: 'REDIS_LOAD_ERROR',
        error,
        message: 'Failed to load tickers from Redis',
      });
    }
  }

  private async saveTickerToRedis(symbol: string, ticker: ITicker24h): Promise<void> {
    try {
      const key = this.getRedisKey(symbol);
      await this.cacheManager.set(key, ticker);
      this.logger.debug({
        event: 'TICKER_SAVED_TO_REDIS',
        symbol,
        ticker,
        message: `Saved 24h ticker to Redis for ${symbol}`,
      });
    } catch (error) {
      this.logger.error({
        event: 'REDIS_SAVE_ERROR',
        symbol,
        error,
        message: 'Failed to save ticker to Redis',
      });
    }
  }

  async updateTicker(trade: AggBuySellTrade): Promise<void> {
    const symbol = trade.symbol.toLowerCase();
    let ticker = this.tickerMap.get(symbol);
    const now = Date.now();

    if (!ticker || now - ticker.openTime >= 24 * 60 * 60 * 1000) {
      // Create new 24h window
      ticker = {
        symbol,
        lastPrice: trade.price,
        highPrice: trade.price,
        lowPrice: trade.price,
        volume: trade.quantity,
        priceChange: 0,
        priceChangePercent: 0,
        lastUpdateTime: now,
        openTime: now,
        closeTime: now + 24 * 60 * 60 * 1000,
      };
      this.tickerMap.set(symbol, ticker);
    } else {
      // Update existing ticker
      const oldPrice = ticker.lastPrice;
      ticker.lastPrice = trade.price;
      ticker.highPrice = Math.max(ticker.highPrice, trade.price);
      ticker.lowPrice = Math.min(ticker.lowPrice, trade.price);
      ticker.volume += trade.quantity;
      ticker.priceChange = trade.price - oldPrice;
      ticker.priceChangePercent = (ticker.priceChange / oldPrice) * 100;
      ticker.lastUpdateTime = now;
    }

    /**
     * broadcast ticker to websocket
     */
    /**
     * WARN: no need to broadcast now because it will be broadcasted from Corn for timebeing.
     */
    // const channelRoom = WebsocketChannelRoom.createMarketChannel(Channels.ticker, symbol);
    // this.websocketService.broadcastMarketDataEvent(channelRoom.room, {
    //   channel: Channels.ticker,
    //   data: ticker,
    // });
    await this.saveTickerToRedis(symbol, ticker);

    this.logger.debug({
      event: 'TICKER_UPDATED',
      symbol,
      ticker,
      message: `Updated 24h ticker for ${symbol}`,
    });
    // TODO: save to db
  }

  getTicker(symbol: string): ITicker24h | null {
    const ticker = this.tickerMap.get(symbol.toLowerCase());
    if (!ticker) {
      return null;
    }

    // Check if ticker is still within 24h window
    if (Date.now() - ticker.openTime >= 24 * 60 * 60 * 1000) {
      this.tickerMap.delete(symbol.toLowerCase());
      return null;
    }

    return ticker;
  }

  getAllTickers(): Map<string, ITicker24h> {
    // Clean up expired tickers
    const now = Date.now();
    for (const [symbol, ticker] of this.tickerMap.entries()) {
      if (now - ticker.openTime >= 24 * 60 * 60 * 1000) {
        this.tickerMap.delete(symbol);
      }
    }

    return new Map(this.tickerMap);
  }
}
</file>

<file path="src/infrastructure/cache/redis/redis-cache-service.ts">
import { OnModuleInit } from '@nestjs/common';
import Redis, { ChainableCommander } from 'ioredis';
import { ICacheManager } from 'src/core/interfaces/cache-manager.interface';
import { LoggerService } from 'src/infrastructure/logger/logger.service';

export class RedisCacheManager implements OnModuleInit, ICacheManager {
  private cacheManager: Redis;
  private transaction: ChainableCommander | null = null;

  constructor(private readonly logger: LoggerService) {}

  async get<T>(key: string): Promise<T | null> {
    try {
      const value = await this.cacheManager.get(key);
      return value ? JSON.parse(value) : null;
    } catch (err) {
      this.logger.error(`Failed to get key "${key}" from Redis`, err);
      return null;
    }
  }

  async set<T>(key: string, value: T, ttl?: number): Promise<void> {
    try {
      const serializedValue = JSON.stringify(value);
      if (this.transaction) {
        if (ttl) {
          this.transaction.set(key, serializedValue, 'PX', ttl);
        } else {
          this.transaction.set(key, serializedValue);
        }
        return;
      }

      if (ttl) {
        await this.cacheManager.set(key, serializedValue, 'PX', ttl);
      } else {
        await this.cacheManager.set(key, serializedValue);
      }
    } catch (err) {
      this.logger.error(`Failed to set key "${key}" in Redis`, err);
    }
  }

  async del(key: string): Promise<void> {
    try {
      if (this.transaction) {
        this.transaction.del(key);
        return;
      }
      await this.cacheManager.del(key);
    } catch (err) {
      this.logger.error(`Failed to delete key "${key}" from Redis`, err);
    }
  }

  async has(key: string): Promise<boolean> {
    try {
      const exists = await this.cacheManager.exists(key);
      return exists === 1;
    } catch (err) {
      this.logger.error(`Failed to check existence of key "${key}" in Redis`, err);
      return false;
    }
  }

  async keys(pattern: string): Promise<string[]> {
    try {
      return await this.cacheManager.keys(pattern);
    } catch (err) {
      this.logger.error(`Failed to get keys with pattern "${pattern}" from Redis`, err);
      return [];
    }
  }

  async watch(key: string): Promise<void> {
    try {
      await this.cacheManager.watch(key);
    } catch (err) {
      this.logger.error(`Failed to watch key "${key}" in Redis`, err);
    }
  }

  async unwatch(): Promise<void> {
    try {
      await this.cacheManager.unwatch();
    } catch (err) {
      this.logger.error('Failed to unwatch keys in Redis', err);
    }
  }

  multi(): ICacheManager {
    this.transaction = this.cacheManager.multi();
    return this;
  }

  async exec(): Promise<boolean> {
    try {
      if (!this.transaction) {
        return false;
      }
      const results = await this.transaction.exec();
      this.transaction = null;
      return results !== null;
    } catch (err) {
      this.logger.error('Failed to execute Redis transaction', err);
      this.transaction = null;
      return false;
    }
  }

  async onModuleInit() {
    try {
      this.cacheManager = new Redis({
        host: process.env.REDIS_HOST,
        port: parseInt(process.env.REDIS_PORT, 10),
        password: process.env.REDIS_PASSWORD,
      });
      this.cacheManager.on('error', (err) => {
        console.log('Redis error', err);
      });
      this.cacheManager.on('connect', () => {
        console.log('Connected to Redis');
      });
    } catch (err) {
      this.logger.error('Failed to connect to Redis', err);
    }
  }
}
</file>

