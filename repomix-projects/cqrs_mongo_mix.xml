<file path="src/core/strategies/create-order/create-stop-limit-order.strategy.ts">
import { Injectable } from '@nestjs/common';
import { NatsTopics, OrderSide } from '@onexchainorg/shared/matching-engine';
import { ITradeOrder } from '@onexchainorg/userpanel-schemas/interfaces';
import { Channels } from 'src/common/constants/channels.constants';
import { IUseCaseResponse } from 'src/common/interface/response/interface/response.result.interface';
import { ICreateOrderStrategy } from 'src/core/interfaces/create-order.interface';
import { ICreateOrderInput } from 'src/core/interfaces/place-order.interface';
import { ITradeOrderRepository } from 'src/core/repositories/trade-order.repository.abstract';
import { TradeBalanceService } from 'src/core/services/trade/trade-balance.service';
import { TradeOrderFactoryService } from 'src/core/services/trade/trade-order.factory.service';
import { NatsService } from 'src/infrastructure/messaging/nats/nats.service';
import { IApiRequestPayload } from 'src/presentation/dtos/api-key/api-key.response';
@Injectable()
export class CreateStopLimitOrderStrategy implements ICreateOrderStrategy {
  constructor(
    private readonly tradeBalanceService: TradeBalanceService,
    private readonly tradeOrderRepository: ITradeOrderRepository,
    private readonly tradeOrderFactoryService: TradeOrderFactoryService,
    private readonly natsService: NatsService,
  ) {}
  async execute(
    orderDto: ICreateOrderInput,
    loginPaylod: IApiRequestPayload,
  ): Promise<IUseCaseResponse<ITradeOrder | null>> {
    let currency = ''; // default currency is first part of symbol assuming it is buy

    if (!orderDto.stopPrice || isNaN(orderDto.stopPrice)) {
      return { success: false, message: 'Invalid stop price', data: null };
    }
    /**
     * get currency from symbol
     */
    if (orderDto.side === OrderSide.sell) {
      currency = orderDto.symbol.split('_')[0];
    } else if (orderDto.side === OrderSide.buy) {
      currency = orderDto.symbol.split('_')[1];
    }

    if (!currency) return { success: false, message: 'Invalid currency', data: null };

    const orderAmtRes = await this.tradeBalanceService.calculateOrderAmount(
      orderDto.side,
      orderDto.price,
      orderDto.quantity,
    );

    if (!orderAmtRes.success) return { success: false, message: orderAmtRes.message, data: null };
    /**
     * calculate the amount of currency to be deducted from the user wallet
     */

    const balanceRes = await this.tradeBalanceService.checkUserBalance(loginPaylod.userId, currency, orderAmtRes.data);

    if (!balanceRes || !balanceRes.success) {
      balanceRes.data = null;
      return { success: false, message: balanceRes.message, data: null };
    }

    const lockRes = await this.tradeBalanceService.lockUserBalance(loginPaylod.userId, currency, orderAmtRes.data);
    if (!lockRes || !lockRes.success) return { success: false, message: lockRes.message, data: null };

    const wallet = lockRes.data.wallet.find((w) => w.currency_code === currency);
    await this.natsService.publish(NatsTopics.balance_update, {
      data: {
        userId: loginPaylod.userId,
        balance: { currency: currency, amount: wallet.Amount, inorder: wallet.inorder },
      },
      event: Channels.balances,
      pair: orderDto.symbol,
    });
    orderDto.userId = loginPaylod.userId;
    orderDto.initialAmount = orderDto.quantity;
    orderDto.price = orderDto.price;
    orderDto.stopPrice = orderDto.stopPrice;

    const tradeOrder = this.tradeOrderFactoryService.createTradeOrder(orderDto);
    tradeOrder.order_type = 'Stop Limit';
    tradeOrder.stop_price = orderDto.stopPrice;
    tradeOrder.status = 'InActive';
    const order = await this.tradeOrderRepository.createOne(tradeOrder);

    if (!order) return { success: false, message: 'Failed to create order', data: null };
    return { success: true, message: 'Order created successfully', data: order };
  }
}
</file>

