  constructor(private readonly tradeHistoryRepo: ITradeTransactionHistoryRepository) {}

  async emitAllKlineIntervals(symbol: string) {
    const intervals = ['1s', '1m', '5m', '15m', '30m', '1h', '4h', '1d', '1w', '1M'];
    const pair = symbol.replace('_', '/');
    const klinePromises = intervals.map((interval) => {
      return this.tradeHistoryRepo.getKlineOfInterval(pair, interval);
    });
    const kileResults = await Promise.all(klinePromises);
    return kileResults;
  }
}
