<file path="src/application/commands/order/trigger-limit-order.command.ts">
import { Injectable } from '@nestjs/common';
import { CommandHandler, ICommand, ICommandHandler } from '@nestjs/cqrs';
import { MatchingEngineOrderResponse, NatsResponse, NatsTopics, OrderSide } from '@onexchainorg/shared/matching-engine';
import { ITradeOrder } from '@onexchainorg/userpanel-schemas/interfaces';
import { Channels } from 'src/common/constants/channels.constants';
import { IDebitCreditBalanceResponse } from 'src/common/interface/debit-credit-balance.response';
import { OrderCreateResponse, OrderResponse } from 'src/common/interface/order-response';
import { IUseCaseResponse } from 'src/common/interface/response/interface/response.result.interface';
import { TradeResponse } from 'src/common/interface/trade-response';
import { AppException } from 'src/core/exceptions/app.exception';
import { ITradeOrderRepository } from 'src/core/repositories/trade-order.repository.abstract';
import { KlineService } from 'src/core/services/market-data/kline.service';
import { ProfitService } from 'src/core/services/trade/profit.service';
import { TradeBalanceService } from 'src/core/services/trade/trade-balance.service';
import { TradeTransactionHistoryService } from 'src/core/services/trade/trade-transaction-history.service';
import { LoggerService } from 'src/infrastructure/logger/logger.service';
import { NatsService } from 'src/infrastructure/messaging/nats/nats.service';

export class TriggerLimitOrderCommand implements ICommand {
  constructor(public readonly order: ITradeOrder) {}
}

@Injectable()
@CommandHandler(TriggerLimitOrderCommand)
export class TriggerLimitOrderCommandHandler
  implements ICommandHandler<TriggerLimitOrderCommand, IUseCaseResponse<OrderCreateResponse>>
{
  constructor(
    private readonly logger: LoggerService,
    private readonly natsService: NatsService,
    private readonly tradeOrderRepository: ITradeOrderRepository,
    private readonly tradeBalanceService: TradeBalanceService,
    private readonly profitService: ProfitService,
    private readonly transactionHistoryService: TradeTransactionHistoryService,
    private readonly klineService: KlineService,
  ) {
    this.logger.setContext(TriggerLimitOrderCommandHandler.name);
  }
  async execute(command: TriggerLimitOrderCommand): Promise<IUseCaseResponse<OrderCreateResponse>> {
    const { order } = command;
    const engRes: NatsResponse<MatchingEngineOrderResponse> = await this.natsService.send('create_order', {
      symbol: order.pair.replace('/', '_'),
      side: order.trade_type,
      price: order.market_price,
      quantity: order.ordered_amount,
      type: 'Limit',
      exOrderId: order.orderId,
      userId: order.user_id,
    });

    if (!engRes) {
      throw new AppException('Failed to place order', 400);
    }

    this.logger.log('engRes', JSON.stringify(engRes));
    if (!engRes.success) throw new AppException(engRes.msg, engRes.statusCode || 400, engRes.errors);

    const updateOrderRes = await this.tradeOrderRepository.updateById(order._id as string, {
      eng_order_id: engRes.data.order.orderId,
      status: engRes.data.order.status,
      partial_amount: engRes.data.order.leaveQuantity,
    });

    if (!updateOrderRes) throw new AppException('Failed to update order', 400);
    /**
     * calculate and deduct maker and taker fees.
     */

    const debitRes = await this.debitAndCreditUserBalance(engRes.data);
    if (!debitRes.success) throw new AppException(debitRes.message, 400);

    if (debitRes.data) {
      this.natsService.publish(NatsTopics.balance_update, {
        data: debitRes.data.buyer,
        event: Channels.balances,
        pair: order.pair.replace('/', '_'),
      });
      this.natsService.publish(NatsTopics.balance_update, {
        data: debitRes.data.seller,
        event: Channels.balances,
        pair: order.pair.replace('/', '_'),
      });
    }

    return {
      data: {
        order: OrderResponse.toResponse(engRes.data.order),
        trades: TradeResponse.toResponses(engRes.data.trades),
      },
      success: true,
      message: 'Order placed successfully',
    };
  }

  async debitAndCreditUserBalance(
    orderRes: MatchingEngineOrderResponse,
  ): Promise<IUseCaseResponse<IDebitCreditBalanceResponse | null>> {
    if (!orderRes.trades || orderRes.trades.length === 0)
      return { data: null, success: true, message: 'No trades found' };

    const res: IDebitCreditBalanceResponse = {
      buyer: { userId: '', balance: { currency: orderRes.order.symbol, amount: 0, inorder: 0 } },
      seller: { userId: '', balance: { currency: orderRes.order.symbol, amount: 0, inorder: 0 } },
    };

    const makerTrades = orderRes.trades.filter((trade) => +trade.orderId !== +orderRes.order.orderId);
    const takerTrades = orderRes.trades.filter((trade) => +trade.orderId === +orderRes.order.orderId);

    const makerOrderRes = await this.tradeBalanceService.calculateMakerFee(
      makerTrades,
      orderRes.order.symbol,
      orderRes.order.side === OrderSide.buy ? OrderSide.sell : OrderSide.buy,
    );

    if (!makerOrderRes.success) return { data: null, success: false, message: 'Failed to calculate maker fee' };
    /**
     * Credit User Balance
     * if Buy SOL_BTC, then credit BTC to seller
     */
    const bulkUpdateMakerBalanceRes = await this.tradeBalanceService.bulkCreditUserBalance(makerOrderRes.data);
    if (!bulkUpdateMakerBalanceRes.success)
      return { data: null, success: false, message: 'Failed to update user balance: maker' };

    /**
     * if order side is buy, then maker is seller
     */
    if (orderRes.order.side === OrderSide.buy) {
      res.seller.userId = makerOrderRes.data[0].userId;
      res.seller.balance = bulkUpdateMakerBalanceRes.data;
    } else {
      res.buyer.userId = makerOrderRes.data[0].userId;
      res.buyer.balance = bulkUpdateMakerBalanceRes.data;
    }
    /**
     * bulk create transaction history
     */
    await this.transactionHistoryService.createBulkTransactionHistory(makerOrderRes.data);
    /**
     * Create Profit for all maker trades of admin
     */
    const makerProfitRes = await this.profitService.createProfitBulk(makerOrderRes.data);
    if (!makerProfitRes.success) return { data: null, success: false, message: 'Failed to create profit for maker' };

    /**
     * After crediting the seller, we need to debit the locked balance of the buyer
     * if Buy SOL_BTC, then debit SOL from buyer
     */
    const bulkDebitMakerLocketAmtRes = await this.tradeBalanceService.bulkDebitLockedBalance(makerOrderRes.data);
    if (!bulkDebitMakerLocketAmtRes.success)
      return { data: null, success: false, message: 'Failed to update user balance maker' };

    /**
     * calculate the taker fee
     */
    const takerOrderRes = await this.tradeBalanceService.calculateTakerFee(
      takerTrades,
      orderRes.order.symbol,
      orderRes.order.side,
    );
    if (!takerOrderRes.success) return { data: null, success: false, message: 'Failed to calculate taker fee' };

    /**
     * Credit User Balance
     */
    const bulkUpdateTakerBalanceRes = await this.tradeBalanceService.bulkCreditUserBalance(takerOrderRes.data);
    if (!bulkUpdateTakerBalanceRes.success)
      return { data: null, success: false, message: 'Failed to update user balance: taker' };

    if (orderRes.order.side === OrderSide.buy) {
      res.buyer.userId = takerOrderRes.data[0].userId;
      res.buyer.balance = bulkUpdateTakerBalanceRes.data;
    } else {
      res.seller.userId = takerOrderRes.data[0].userId;
      res.seller.balance = bulkUpdateTakerBalanceRes.data;
    }
    /**
     * bulk create transaction history
     */
    await this.transactionHistoryService.createBulkTransactionHistory(takerOrderRes.data);
    const takerProfitRes = await this.profitService.createProfitBulk(takerOrderRes.data);
    if (!takerProfitRes.success) return { data: null, success: false, message: 'Failed to create profit for taker' };

    /**
     * Update the locked balance
     */
    const bulkDebitTakerLockedAmtRes = await this.tradeBalanceService.bulkDebitLockedBalance(takerOrderRes.data);
    if (!bulkDebitTakerLockedAmtRes.success)
      return { data: null, success: false, message: 'Failed to update user balance- taker' };

    return { data: res, success: true, message: 'Success' };
  }
}
</file>

