import { Model } from 'mongoose';
import { IGenericRepository } from 'src/core/repositories/generic-repository.abstract';

export class MongoGenericRepository<T> implements IGenericRepository<T> {
  protected _model: Model<T>;

  constructor(model: Model<T>) {
    this._model = model;
  }

  async createOne(item: T, session?: any): Promise<T> {
    const createdItem = await this._model.create([item], { session });
    return createdItem[0] as T;
  }
  async createMany(items: T[], session?: any): Promise<T[]> {
    const createdItems = await this._model.create(items, { session });
    return createdItems as T[];
  }

  async findById(id: string, session?: any): Promise<T | null> {
    const foundItem = await this._model.findById(id).session(session).exec();
    if (!foundItem) {
      return null;
    }
    return foundItem as T;
  }

  async updateById(id: string, item: Partial<T>, session?: any): Promise<T> {
    const updatedItem = await this._model.findByIdAndUpdate(id, item, { new: true, session }).exec();
    if (!updatedItem) {
      return null;
    }
    return updatedItem as T;
  }

  async deleteById(id: string, session?: any): Promise<T> {
    const deletedItem = await this._model.findByIdAndDelete(id, { session }).exec();
    if (!deletedItem) {
      return null;
    }
    return deletedItem as T;
  }

  async findAll(session?: any): Promise<T[]> {
    const foundItems = await this._model.find({}).session(session).exec();
    return foundItems as T[];
  }
}
</file>

