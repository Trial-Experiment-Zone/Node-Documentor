<file path="src/infrastructure/data-sources/mongo/repositories/user-wallet.repository.ts">
import { Inject, Injectable } from '@nestjs/common';
import { IWallet } from '@onexchainorg/userpanel-schemas/interfaces';
import mongoose, { Model } from 'mongoose';
import { InjectableEntities } from 'src/application/commands/injectable.string';
import { ICalculateFeeResponse } from 'src/common/interface/calculate-fee.response';
import { IUserWalletRepository, IWalletBalance } from 'src/core/repositories/user-wallet.repository.abstract';
import { MongoGenericRepository } from './mongo-generic.repository';

@Injectable()
export class UserWalletRepository extends MongoGenericRepository<IWallet> implements IUserWalletRepository {
  constructor(@Inject(InjectableEntities.UserWalletEntity) readonly userWalletEntity: Model<IWallet>) {
    super(userWalletEntity);
  }
  async getUserBalanceByCurrency(userId: string, currency: string): Promise<IWalletBalance | null> {
    const result = await this.userWalletEntity.aggregate([
      {
        $unwind: '$wallet',
      },
      {
        $lookup: {
          from: 'currency',
          localField: 'wallet.currency_code',
          foreignField: 'code',
          as: 'currdetail',
        },
      },
      {
        $match: {
          userId: new mongoose.Types.ObjectId(userId),
          'currdetail.code': currency,
        },
      },
      {
        $project: {
          _id: 0,
          spot_balance: '$wallet.Amount',
          inorder: '$wallet.inorder',
        },
      },
    ]);

    if (!result || result.length === 0) {
      return null;
    }
    return {
      spotBalance: result[0].spot_balance,
      inorder: result[0].inorder,
    };
  }

  async lockUserBalance(userId: string, currency: string, amount: number): Promise<IWallet | null> {
    amount = +amount.toFixed(8);
    const result = await this.userWalletEntity.findOneAndUpdate(
      {
        userId: new mongoose.Types.ObjectId(userId),
        'wallet.currency_code': currency,
      },
      {
        $inc: {
          'wallet.$.Amount': -amount,
          'wallet.$.inorder': amount,
        },
      },
      { new: true },
    );

    if (!result) {
      return null;
    }

    return result;
  }

  async bulkCreditUserBalance(data: ICalculateFeeResponse[]): Promise<boolean | null> {
    const bulkOps = [];
    for (const item of data) {
      const bulkUpdateOpsElement = {
        updateOne: {
          filter: { userId: new mongoose.Types.ObjectId(item.userId), 'wallet.currency_code': item.currency },
          update: { $inc: { 'wallet.$.Amount': +item.userAmount.toFixed(8) } },
        },
      };

      bulkOps.push(bulkUpdateOpsElement);
    }

    try {
      const updateResponse = await this.userWalletEntity.bulkWrite(bulkOps, { ordered: true });
      if (updateResponse.modifiedCount > 0) {
        return true;
      } else {
        return false;
      }
    } catch (error) {
      console.error('Error in bulk credit user balance:', error);
      return null;
    }
  }

  async bulkDebitLockedBalance(data: ICalculateFeeResponse[]): Promise<boolean | null> {
    const bulkUpdateOps: any = [];
    for (let index = 0; index < data.length; index++) {
      const order = data[index];
      const { userId, lockedCurrency, lockedAmount: lockedValue } = order;
      const bulkUpdateOpsElement = {
        updateOne: {
          filter: { userId: new mongoose.Types.ObjectId(userId.toString()), 'wallet.currency_code': lockedCurrency },
          update: { $inc: { 'wallet.$.inorder': -lockedValue } },
        },
      };
      bulkUpdateOps.push(bulkUpdateOpsElement);
    }
    if (bulkUpdateOps.length > 0) {
      try {
        const updateResponse = await this.userWalletEntity.bulkWrite(bulkUpdateOps, { ordered: true });
        if (updateResponse.modifiedCount > 0) {
          return true;
        } else {
          return false;
        }
      } catch (error) {
        console.error(error);
        return null;
      }
    }
  }

  async refundLockedBalance(userId: string, currency: string, amount: number): Promise<IWallet | null> {
    const result = await this.userWalletEntity.findOneAndUpdate(
      {
        userId: new mongoose.Types.ObjectId(userId),
        'wallet.currency_code': currency,
      },
      {
        $inc: {
          'wallet.$.inorder': -amount,
          'wallet.$.Amount': +amount,
        },
      },
      { new: true },
    );
    return result;
  }
}
