import { Injectable } from '@nestjs/common';
import { OrderSide } from '@onexchainorg/shared/matching-engine';
import { ITradeTransactionHistory } from '@onexchainorg/userpanel-schemas/interfaces';
import { ICalculateFeeResponse } from 'src/common/interface/calculate-fee.response';
import { IUseCaseResponse } from 'src/common/interface/response/interface/response.result.interface';
import { ITradeTransactionHistoryRepository } from 'src/core/repositories/trade-transation-history.repository.abstract';

export const generateRandomString = (length) => {
  let result = '';
  const characters = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789';
  const charactersLength = characters.length;
  for (let i = 0; i < length; i++) {
    result += characters.charAt(Math.floor(Math.random() * charactersLength));
  }
  return result;
};
@Injectable()
export class TradeTransactionHistoryService {
  constructor(private readonly transactionHistoryRepo: ITradeTransactionHistoryRepository) {}
  createTradeTransactionModel(data: ICalculateFeeResponse): IUseCaseResponse<ITradeTransactionHistory> {
    const transactionID = generateRandomString(10);
    return {
      data: {
        seller_user_id: data.orderSide === OrderSide.sell ? data.userId : null,
        buyer_user_id: data.orderSide === OrderSide.sell ? null : data.userId,
        trade_user_id: data.userId, // To identify who's transaction.
        transaction_id: transactionID,
        amount: data.tradeQuantity,
        price: data.tradePrice,
        total: data.tradeTotal,
        filled_amount: data.tradeQuantity,
        pair: data.symbol,
        order_type: data.orderType,
        trade_type: data.orderSide,
        admin_fee_percentage: data.adminFeePercent,
        admin_fee_amount: data.adminFee,
      } as unknown as ITradeTransactionHistory,
      message: 'Success',
      success: true,
    };
  }

  async createBulkTransactionHistory(data: ICalculateFeeResponse[]): Promise<IUseCaseResponse<boolean>> {
    const transactionHistories: ITradeTransactionHistory[] = [];
    for (const item of data) {
      const transactionHistory = this.createTradeTransactionModel(item);
      transactionHistories.push(transactionHistory.data);
    }
    const result = await this.transactionHistoryRepo.bulkCreateTradeTransactionHistory(transactionHistories);
    return { data: result, message: 'Success', success: true };
  }
}
