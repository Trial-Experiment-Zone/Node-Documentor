<file path="src/presentation/modules/websocket/websocket.adapter.ts">
import { INestApplicationContext } from '@nestjs/common';
import { IoAdapter } from '@nestjs/platform-socket.io';
import { Server, ServerOptions } from 'socket.io';
import { LoggerService } from 'src/infrastructure/logger/logger.service';

export class CustomWebSocketAdapter extends IoAdapter {
  private logger: LoggerService;
  private readonly app: INestApplicationContext;

  constructor(app: INestApplicationContext) {
    super(app);
    this.app = app;
  }

  async connectLogger(): Promise<void> {
    this.logger = await this.app.resolve(LoggerService);
    this.logger.setContext(CustomWebSocketAdapter.name);
  }

  createIOServer(port: number, options?: ServerOptions): Server {
    this.connectLogger().catch((err) => console.error('Failed to connect logger in WebSocketAdapter:', err));

    const defaultOptions = {
      cors: {
        origin: '*',
        methods: ['GET', 'POST', 'OPTIONS'],
        credentials: true,
        allowedHeaders: ['authorization', 'x-api-key', 'content-type'],
      },
      allowEIO3: true,
      connectTimeout: 45000,
      pingTimeout: 30000,
      pingInterval: 25000,
      transports: ['websocket', 'polling'],
      maxHttpBufferSize: 1e8, // 100MB
    };

    // Create the server with merged options
    const server = super.createIOServer(port, {
      ...defaultOptions,
      ...options,
    });

    // Handle socket.io connection error
    server.engine.on('connection_error', (err) => {
      if (this.logger) {
        this.logger.error(`Connection error: ${err.message}`, err.stack);
      } else {
        console.error('Socket.io connection error:', err.message, err.stack);
      }
    });

    return server;
  }
}
</file>

