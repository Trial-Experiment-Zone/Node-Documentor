<file path="src/infrastructure/scheduler/candles/long-term-candle.scheduler.ts">
import { Injectable } from '@nestjs/common';
import { Cron } from '@nestjs/schedule';
import { ITradePairRepository } from 'src/core/repositories/trade-pair.repository.abstract';
import { LongTermCandleGeneratorService } from 'src/core/services/market-data/long-term-candle-generator.service';
import { LoggerService } from '../../logger/logger.service';

@Injectable()
export class LongTermCandleScheduler {
  constructor(
    private readonly longTermCandleGenerator: LongTermCandleGeneratorService,
    private readonly tradePairRepository: ITradePairRepository,
    private readonly logger: LoggerService,
  ) {
    this.logger.setContext(LongTermCandleScheduler.name);
  }

  /**
   * This cron will run every 4 hours starting from UTC 12:00
   * i.e., at 12:00, 16:00, 20:00, 00:00, 04:00, 08:00
   */

  @Cron('0 0/4 * * *', {
    timeZone: 'UTC',
  })
  async generate4HourCandles() {
    try {
      this.logger.debug('Starting 4h candle generation scheduler');

      const activePairs = await this.tradePairRepository.getAllActiveTradePairs();
      const symbols = activePairs.map((pair) => String(pair.pair));

      await Promise.all(
        symbols.map(async (symbol) => {
          try {
            await this.longTermCandleGenerator.generate4HourCandle(symbol);
          } catch (error) {
            this.logger.error({
              event: 'GENERATE_4H_CANDLE_ERROR',
              symbol,
              error,
              message: `Failed to generate 4h candle for symbol ${symbol}`,
            });
          }
        }),
      );

      this.logger.debug('Completed 4h candle generation scheduler');
    } catch (error) {
      this.logger.error({
        event: 'GENERATE_4H_CANDLES_ERROR',
        error,
        message: 'Failed to execute 4h candle generation scheduler',
      });
    }
  }

  /**
   * This cron will run at the start of each day (00:00 UTC)
   */
  @Cron('0 0 * * *', {
    timeZone: 'UTC',
  })
  async generate1DayCandles() {
    try {
      this.logger.debug('Starting 1d candle generation scheduler');

      const activePairs = await this.tradePairRepository.getAllActiveTradePairs();
      const symbols = activePairs.map((pair) => String(pair.pair));

      await Promise.all(
        symbols.map(async (symbol) => {
          try {
            await this.longTermCandleGenerator.generate1DayCandle(symbol);
          } catch (error) {
            this.logger.error({
              event: 'GENERATE_1D_CANDLE_ERROR',
              symbol,
              error,
              message: `Failed to generate 1d candle for symbol ${symbol}`,
            });
          }
        }),
      );

      this.logger.debug('Completed 1d candle generation scheduler');
    } catch (error) {
      this.logger.error({
        event: 'GENERATE_1D_CANDLES_ERROR',
        error,
        message: 'Failed to execute 1d candle generation scheduler',
      });
    }
  }

  /**
   * This cron will run at the start of each week (Monday 00:00 UTC)
   */
  @Cron('0 0 * * 1', {
    timeZone: 'UTC',
  })
  async generate1WeekCandles() {
    try {
      this.logger.debug('Starting 1w candle generation scheduler');

      const activePairs = await this.tradePairRepository.getAllActiveTradePairs();
      const symbols = activePairs.map((pair) => String(pair.pair));

      await Promise.all(
        symbols.map(async (symbol) => {
          try {
            await this.longTermCandleGenerator.generate1WeekCandle(symbol);
          } catch (error) {
            this.logger.error({
              event: 'GENERATE_1W_CANDLE_ERROR',
              symbol,
              error,
              message: `Failed to generate 1w candle for symbol ${symbol}`,
            });
          }
        }),
      );

      this.logger.debug('Completed 1w candle generation scheduler');
    } catch (error) {
      this.logger.error({
        event: 'GENERATE_1W_CANDLES_ERROR',
        error,
        message: 'Failed to execute 1w candle generation scheduler',
      });
    }
  }

  /**
   * This cron will run at midnight on the first day of every month (00:00 UTC on 1st)
   */
  @Cron('0 0 1 * *', {
    timeZone: 'UTC',
  })
  async generate1MonthCandles() {
    try {
      this.logger.debug('Starting 1M candle generation scheduler');

      const activePairs = await this.tradePairRepository.getAllActiveTradePairs();
      const symbols = activePairs.map((pair) => String(pair.pair));

      await Promise.all(
        symbols.map(async (symbol) => {
          try {
            await this.longTermCandleGenerator.generate1MonthCandle(symbol);
          } catch (error) {
            this.logger.error({
              event: 'GENERATE_1M_CANDLE_ERROR',
              symbol,
              error,
              message: `Failed to generate 1M candle for symbol ${symbol}`,
            });
          }
        }),
      );

      this.logger.debug('Completed 1M candle generation scheduler');
    } catch (error) {
      this.logger.error({
        event: 'GENERATE_1M_CANDLES_ERROR',
        error,
        message: 'Failed to execute 1M candle generation scheduler',
      });
    }
  }
}
