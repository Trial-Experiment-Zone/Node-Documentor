import { Inject, Injectable } from '@nestjs/common';
import { ITradePair } from '@onexchainorg/userpanel-schemas/interfaces';
import { Model } from 'mongoose';
import { InjectableEntities } from 'src/application/commands/injectable.string';
import { ITradePairRepository } from 'src/core/repositories/trade-pair.repository.abstract';
import { MongoGenericRepository } from './mongo-generic.repository';

@Injectable()
export class TradePairRepository extends MongoGenericRepository<ITradePair> implements ITradePairRepository {
  constructor(@Inject(InjectableEntities.TradePairEntity) readonly TradePairEntity: Model<ITradePair>) {
    super(TradePairEntity);
  }

  async getTradePairBySymbol(symbol: string): Promise<ITradePair | null> {
    const data = await this.TradePairEntity.findOne({ pair: symbol }).lean().exec();
    if (!data) return null;
    return data;
  }

  async getTradePairsBySymbols(symbols: string[]): Promise<ITradePair[]> {
    if (!symbols || symbols.length === 0) return [];
    const data = await this.TradePairEntity.find({ pair: { $in: symbols } })
      .lean()
      .exec();
    return data;
  }

  async getAllActiveTradePairs(): Promise<ITradePair[]> {
    return this.TradePairEntity.find({ status: 'Active' }).lean().exec();
  }

  async bulkUpdateTradePrice(updates: { pair: string; price: string; updated_by: string }[]): Promise<void> {
    try {
      const bulkOps = updates.map((update) => ({
        updateOne: {
          filter: { pair: update.pair },
          update: { $set: { last_price: update.price, updated_by: update.updated_by } },
        },
      }));

      if (bulkOps.length > 0) {
        await this.TradePairEntity.bulkWrite(bulkOps, {
          ordered: false,
        });
      }
    } catch (error) {
      console.error('Error in bulkUpdateTradePrice:', error);
      throw error;
    }
  }
}
