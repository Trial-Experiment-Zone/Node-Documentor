import { Injectable } from '@nestjs/common';
import { EventEmitter2 } from '@nestjs/event-emitter';
import { Namespace } from 'socket.io';
import { Channels } from 'src/common/constants/channels.constants';
import { OrderResponse } from 'src/common/interface/order-response';
import { IWebSocketMessage } from 'src/core/interfaces/websocket-message.interface';
import { WebsocketChannelRoom } from 'src/core/value-ojects/websocket-channel.vo';
import { LoggerService } from 'src/infrastructure/logger/logger.service';
import { NatsService } from 'src/infrastructure/messaging/nats/nats.service';

@Injectable()
export class WebSocketService {
  private namespace: Namespace;

  // Map to track clients subscribed to specific stream names (rooms)
  private roomSubscriptions = new Map<string, Set<string>>();

  constructor(
    private readonly natsService: NatsService,
    private readonly logger: LoggerService,
    private readonly eventEmitter: EventEmitter2,
  ) {
    this.logger.setContext(WebSocketService.name);
  }

  /**
   * Set the WebSocket server instance for combined streams (called by the gateway)
   */
  setServer(server: Namespace): void {
    this.namespace = server;
    this.logger.log('Combined stream WebSocket server initialized');
  }

  /**
   * Broadcast an event to all connected WebSocket clients in a specific room
   */
  broadcastMarketDataEvent<T>(roomName: string, payload: IWebSocketMessage<T>): void {
    // Broadcast to combined stream clients in the specified room
    if (this.namespace) {
      try {
        this.namespace.to(roomName).emit('events', payload);
      } catch (error) {
        this.logger.error(`Error broadcasting to combined streams: ${error.message}`, error.stack);
      }
    }
  }

  emitBalanceUpdate(payload: IWebSocketMessage<any>): void {
    const userId = payload.data.userId;
    const room = WebsocketChannelRoom.createUserChannel(Channels.balances, userId);
    this.namespace.to(room.room).emit('events', payload);
  }

  emitExecution(payload: IWebSocketMessage<any>): void {
    const userId = payload.data.userId;
    const room = WebsocketChannelRoom.createUserChannel(Channels.execution, userId);
    payload.data = OrderResponse.toResponse(payload.data);
    this.namespace.to(room.room).emit('events', payload);
  }
}
</file>

