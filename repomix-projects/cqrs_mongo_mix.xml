import { Injectable } from '@nestjs/common';
import { CommandBus } from '@nestjs/cqrs';
import { OnEvent } from '@nestjs/event-emitter';
import { OrderStatus } from '@onexchainorg/shared/matching-engine';
import { TriggerLimitOrderCommand } from 'src/application/commands/order/trigger-limit-order.command';
import { OrderCreateResponse } from 'src/common/interface/order-response';

import { IUseCaseResponse } from 'src/common/interface/response/interface/response.result.interface';
import { ITradeOrderRepository } from 'src/core/repositories/trade-order.repository.abstract';
import { LoggerService } from 'src/infrastructure/logger/logger.service';

@Injectable()
export class StopOrderListener {
  constructor(
    private readonly tradeOrderRepo: ITradeOrderRepository,
    private readonly commandBus: CommandBus,
    private readonly logger: LoggerService,
  ) {
    this.logger.setContext(StopOrderListener.name);
  }

  @OnEvent('trigger.limit.order')
  async handleTriggerLimitOrderEvent(data: { stopPrice: number; symbol: string }) {
    const pair = data.symbol.replace('_', '/');

    await this.tradeOrderRepo.updateStatusOfSellLimitOrder(pair, OrderStatus.active, data.stopPrice);
    await this.tradeOrderRepo.updateStatusOfBuyLimitOrder(pair, OrderStatus.active, data.stopPrice);
    const activeOrders = await this.tradeOrderRepo.getActiveLimitOrder(pair);

    if (!activeOrders) {
      return;
    }

    for (const order of activeOrders) {
      try {
        const res = await this.commandBus.execute<TriggerLimitOrderCommand, IUseCaseResponse<OrderCreateResponse>>(
          new TriggerLimitOrderCommand(order),
        );

        if (!res.success) {
          this.logger.error(`Failed to trigger limit order ${JSON.stringify(res)}`);
        }
      } catch (e) {
        this.logger.error(`Failed to trigger limit order ${JSON.stringify(order)}`, e);
        continue;
      }
    }
  }
}
