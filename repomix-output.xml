@Injectable()
export class CurrencyRepository extends MongoGenericRepository<ICurrency> implements ICurrencyRepository {
  constructor(@Inject(InjectableEntities.CurrencyEntity) readonly currencyEntity: Model<ICurrency>) {
    super(currencyEntity);
  }
  async getCurrencyByCode(code: string): Promise<ICurrency | null> {
    try {
      return await this.currencyEntity.findOne({ code }).lean().exec();
    } catch (error) {
      console.error(`Error fetching currency by code: ${code}`, error);
      return null;
    }
  }

  async getCurrencyDetailsByPair(pair: string): Promise<ICurrency[] | null> {
    try {
      const codes = pair.split('_');
      return await this.currencyEntity.find({ code: { $in: codes } }).exec();
    } catch (error) {
      console.error(`Error fetching currency details by pair: ${pair}`, error);
      return null;
    }
  }
}
